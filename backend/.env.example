# Server Port
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/scanms_db"

# Supabase Integration (Optional)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SECRET_KEY="your_secret_key"

# Redis Cache & Task Queue
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your_refresh_secret_key_here"
JWT_REFRESH_EXPIRES_IN="7d"

# Attribution Configuration
ATTRIBUTION_WINDOW_DAYS=30
MIN_PAYOUT_AMOUNT=200000.00

# Cloudinary Storage Configuration
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# FR-24 private bank bills and VietQR export (no payer bank credentials here)
PAYOUT_MAX_BILL_BYTES=5242880
PAYOUT_BILL_FOLDER=scanms/payouts/bills
PAYOUT_VIETQR_BASE_URL=https://img.vietqr.io/image/
PAYOUT_VIETQR_TEMPLATE=compact2
# Populate from the official bank API https://api.vietqr.io/v2/banks.
# Example only; configure the banks/aliases used by collaborator profiles.
PAYOUT_VIETQR_BANKS='[{"bin":"970436","code":"VCB","name":"Vietcombank","aliases":["Ngân hàng Ngoại thương"]}]'
