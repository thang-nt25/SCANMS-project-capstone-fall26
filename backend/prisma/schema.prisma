datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (CODE-FIRST DOMAIN DEFINITIONS)
// ==========================================

enum UserRole {
  SYSTEM_ADMIN
  SYSTEM_MANAGER
  SHOP_MANAGER
  COLLABORATOR
}

enum KycStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum SocialPlatform {
  TIKTOK
  FACEBOOK
  YOUTUBE
  INSTAGRAM
  THREADS
  ZALO
  TELEGRAM
  SHOPEE_VIDEO
  LEMON8
  OTHER
}

enum AssetType {
  IMAGE
  VIDEO
  COPYWRITE_TEXT
}

enum SampleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
}

enum AttributionMethod {
  COOKIE
  COUPON
  FINGERPRINT
}

enum AccessMethod {
  LINK
  QR
}

enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum TransactionType {
  COMMISSION_APPROVED
  PAYOUT_WITHDRAW
  REVERSAL
  PAYOUT_REJECT_REFUND
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignParticipantStatus {
  INVITED
  ACCEPTED
  REJECTED
}

enum ReferralLinkStatus {
  ACTIVE
  PAUSED
  BLOCKED
  EXPIRED
}

enum StoreCollaboratorStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum CouponStatus {
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
  BLOCKED
  DELETED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  STORE_WIDE
  PRODUCTS
  CATEGORIES
  CAMPAIGN
}

enum CouponFundingSource {
  SHOP_FUNDED
  CO_FUNDED
  PLATFORM_FUNDED
}

enum CouponRedemptionStatus {
  RESERVED
  USED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

// ==========================================
// 2. USER & COLLABORATOR SUBSYSTEM
// ==========================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(COLLABORATOR)
  fullName     String    @map("full_name") @db.VarChar(150)
  phoneNumber  String?   @map("phone_number") @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Reverse Relations
  stores                    Store[]
  collaboratorProfile       CollaboratorProfile?
  socialChannels            CollaboratorSocialChannel[]
  sampleProductRequests     SampleProductRequest[]
  referralLinks             ReferralLink[]
  attributedOrders          Order[]                     @relation("AttributedCollaboratorOrders")
  commissions               Commission[]
  wallet                    Wallet?
  payoutRequests            PayoutRequest[]
  collaboratorConversations Conversation[]              @relation("CollaboratorConversations")
  sentChatMessages          ChatMessage[]               @relation("SentChatMessages")
  campaignParticipants      CampaignParticipant[]
  storeCollaborations       StoreCollaborator[]         @relation("CollaboratorStoreRelations")
  monthlyBonusResults       MonthlyBonusResult[]        @relation("CollaboratorMonthlyBonusResults")
  auditLogs                 AuditLog[]
  coupons                   Coupon[]                    @relation("CollaboratorCoupons")
  approvedCoupons           Coupon[]                    @relation("CouponApprover")
  notifications             Notification[]

  @@map("users")
}

model Store {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                String    @map("owner_id") @db.Uuid
  name                   String    @db.VarChar(200)
  slug                   String    @unique @db.VarChar(200)
  logoUrl                String?   @map("logo_url")
  description            String?
  websiteUrl             String?   @map("website_url") @db.VarChar(255)
  defaultCommissionRate  Decimal   @default(10.00) @map("default_commission_rate") @db.Decimal(5, 2)
  attributionWindowDays  Int       @default(30) @map("attribution_window_days")
  minPayoutAmount        Decimal   @default(200000.00) @map("min_payout_amount") @db.Decimal(15, 2)
  isDeleted              Boolean   @default(false) @map("is_deleted")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  owner                  User                @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products               Product[]
  mediaAssets            MediaAsset[]
  commissionRules        CommissionRule[]
  campaigns              Campaign[]
  orders                 Order[]
  conversations          Conversation[]
  payoutRequests         PayoutRequest[]
  monthlyBonusResults    MonthlyBonusResult[]
  referralLinks          ReferralLink[]
  storeCollaborators     StoreCollaborator[]
  coupons                Coupon[]

  @@index([ownerId], map: "idx_fk_stores_owner")
  @@map("stores")
}

model StoreCollaborator {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String                  @map("store_id") @db.Uuid
  collaboratorId String                  @map("collaborator_id") @db.Uuid
  status         StoreCollaboratorStatus @default(PENDING)
  approvedAt     DateTime?               @map("approved_at") @db.Timestamptz(6)
  note           String?                 @db.VarChar(255)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store        Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User  @relation("CollaboratorStoreRelations", fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([storeId, collaboratorId], map: "idx_unique_store_collab")
  @@index([storeId], map: "idx_fk_store_collab_store")
  @@index([collaboratorId], map: "idx_fk_store_collab_user")
  @@map("store_collaborators")
}

model CollaboratorTier {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(50)
  minRevenueThreshold  Decimal  @default(0.00) @map("min_revenue_threshold") @db.Decimal(15, 2)
  extraBonusPercentage Decimal  @default(0.00) @map("extra_bonus_percentage") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Reverse Relations
  collaboratorProfiles CollaboratorProfile[]

  @@map("collaborator_tiers")
}

model CollaboratorProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  tierId                String?   @map("tier_id") @db.Uuid
  avatarUrl             String?   @map("avatar_url")
  bio                   String?
  idCardNumber          String?   @map("id_card_number") @db.VarChar(50)
  taxCode               String?   @map("tax_code") @db.VarChar(50)
  bankName              String    @map("bank_name") @db.VarChar(100)
  bankAccountNumber     String    @map("bank_account_number") @db.VarChar(50)
  bankAccountName       String    @map("bank_account_name") @db.VarChar(150)
  socialLinksJson       Json?     @map("social_links_json")
  totalFollowers        Int       @default(0) @map("total_followers")
  totalEarnedCommission Decimal   @default(0.00) @map("total_earned_commission") @db.Decimal(15, 2)
  totalOrdersReferred   Int       @default(0) @map("total_orders_referred")
  kycStatus             KycStatus @default(UNVERIFIED) @map("kyc_status")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tier CollaboratorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tierId], map: "idx_fk_collab_profiles_tier")
  @@map("collaborator_profiles")
}

model CollaboratorSocialChannel {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId String         @map("collaborator_id") @db.Uuid
  platformName   SocialPlatform @map("platform_name")
  channelName    String?        @map("channel_name") @db.VarChar(150)
  channelUrl     String         @map("channel_url")
  followerCount  Int            @default(0) @map("follower_count")
  isPrimary      Boolean        @default(false) @map("is_primary")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  collaborator User @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([collaboratorId], map: "idx_social_channels_collab")
  @@map("collaborator_social_channels")
}

// ==========================================
// 3. CATALOG & MEDIA ASSETS SUBSYSTEM
// ==========================================

model Product {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  sku                  String    @db.VarChar(100)
  title                String    @db.VarChar(255)
  categoryName         String?   @map("category_name") @db.VarChar(100)
  description          String?
  imageUrl             String?   @map("image_url")
  originalPrice        Decimal?  @map("original_price") @db.Decimal(15, 2)
  price                Decimal   @db.Decimal(15, 2)
  customCommissionRate Decimal?  @map("custom_commission_rate") @db.Decimal(5, 2)
  stockQuantity        Int       @default(0) @map("stock_quantity")
  isActive             Boolean   @default(true) @map("is_active")
  isAffiliateEnabled   Boolean   @default(true) @map("is_affiliate_enabled")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mediaAssets           MediaAsset[]
  sampleProductRequests SampleProductRequest[]
  referralLinks         ReferralLink[]
  orderItems            OrderItem[]
  productReviews        ProductReview[]
  campaignProducts      CampaignProduct[]
  couponProducts        CouponProduct[]

  @@index([storeId], map: "idx_fk_products_store")
  @@map("products")
}

model ProductReview {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  customerName   String?  @map("customer_name") @db.VarChar(150)
  rating         Int      @default(5)
  comment        String?
  reviewImageUrl String?  @map("review_image_url")
  isApproved     Boolean  @default(true) @map("is_approved")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId], map: "idx_fk_product_reviews_product")
  @@index([orderId], map: "idx_fk_product_reviews_order")
  @@map("product_reviews")
}

model MediaAsset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  productId    String?   @map("product_id") @db.Uuid
  title        String    @db.VarChar(255)
  assetType    AssetType @map("asset_type")
  urlOrContent String    @map("url_or_content")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId], map: "idx_fk_media_assets_store")
  @@index([productId], map: "idx_fk_media_assets_product")
  @@map("media_assets")
}

model CommissionRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  name              String    @db.VarChar(150)
  description       String?
  minMonthlyRevenue Decimal   @default(0.00) @map("min_monthly_revenue") @db.Decimal(15, 2)
  achievementBonus  Decimal   @default(0.00) @map("achievement_bonus") @db.Decimal(15, 2)
  bonusPercentage   Decimal   @default(0.00) @map("bonus_percentage") @db.Decimal(5, 2)
  isActive          Boolean   @default(true) @map("is_active")
  version           Int       @default(1)
  effectiveFrom     DateTime? @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  monthlyBonusResults MonthlyBonusResult[]

  @@index([storeId], map: "idx_fk_commission_rules_store")
  @@map("commission_rules")
}

model MonthlyBonusResult {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String            @map("store_id") @db.Uuid
  collaboratorId      String            @map("collaborator_id") @db.Uuid
  yearMonth           String            @map("year_month") @db.VarChar(7) // Định dạng YYYY-MM (VD: 2026-09)
  validRevenue        Decimal           @map("valid_revenue") @db.Decimal(15, 2)
  appliedRuleId       String?           @map("applied_rule_id") @db.Uuid
  appliedRuleName     String?           @map("applied_rule_name") @db.VarChar(150)
  bonusPercentage     Decimal?          @map("bonus_percentage") @db.Decimal(5, 2)
  achievementBonus    Decimal           @default(0.00) @map("achievement_bonus") @db.Decimal(15, 2)
  bonusAmount         Decimal           @map("bonus_amount") @db.Decimal(15, 2)
  ruleSnapshot        Json?             @map("rule_snapshot")
  status              CommissionStatus  @default(PENDING)
  settledAt           DateTime          @default(now()) @map("settled_at") @db.Timestamptz(6)
  approvedAt          DateTime?         @map("approved_at") @db.Timestamptz(6)
  paidAt              DateTime?         @map("paid_at") @db.Timestamptz(6)
  walletTransactionId String?           @map("wallet_transaction_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User              @relation("CollaboratorMonthlyBonusResults", fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appliedRule  CommissionRule?   @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  adjustments  BonusAdjustment[]

  @@unique([storeId, collaboratorId, yearMonth], map: "idx_unique_monthly_bonus_settlement")
  @@index([storeId, yearMonth], map: "idx_monthly_bonus_store_month")
  @@index([collaboratorId, yearMonth], map: "idx_monthly_bonus_collab_month")
  @@map("monthly_bonus_results")
}

model SampleProductRequest {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId  String              @map("collaborator_id") @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  shippingAddress String              @map("shipping_address")
  trackingNumber  String?             @map("tracking_number") @db.VarChar(100)
  status          SampleRequestStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  collaborator User    @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([collaboratorId], map: "idx_fk_sample_req_collab")
  @@index([productId], map: "idx_fk_sample_req_product")
  @@map("sample_product_requests")
}

// ==========================================
// 4. TRACKING & ATTRIBUTION SUBSYSTEM
// ==========================================

model ReferralLink {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId   String             @map("collaborator_id") @db.Uuid
  storeId          String             @map("store_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  campaignId       String?            @map("campaign_id") @db.Uuid
  shortCode        String             @unique @map("short_code") @db.VarChar(50)
  label            String?            @db.VarChar(150)
  channel          SocialPlatform?    @map("channel")
  destinationPath  String             @default("/products") @map("destination_path") @db.VarChar(255)
  utmSource        String?            @map("utm_source") @db.VarChar(100)
  utmMedium        String?            @map("utm_medium") @db.VarChar(100)
  utmCampaign      String?            @map("utm_campaign") @db.VarChar(100)
  utmContent       String?            @map("utm_content") @db.VarChar(100)
  status           ReferralLinkStatus @default(ACTIVE)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  disabledReason   String?            @map("disabled_reason") @db.VarChar(255)
  disabledBy       String?            @map("disabled_by") @db.Uuid
  disabledAt       DateTime?          @map("disabled_at") @db.Timestamptz(6)
  lastAccessedAt   DateTime?          @map("last_accessed_at") @db.Timestamptz(6)
  customCouponCode String?            @map("custom_coupon_code") @db.VarChar(50)
  qrCodeUrl        String?            @map("qr_code_url")
  qrDownloadCount  Int                @default(0) @map("qr_download_count")
  totalClicks      Int                @default(0) @map("total_clicks")
  uniqueClicks     Int                @default(0) @map("unique_clicks")
  totalOrders      Int                @default(0) @map("total_orders")
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  collaborator     User              @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clickTrafficLogs ClickTrafficLog[]
  orders           Order[]
  orderItems       OrderItem[]

  @@index([collaboratorId, createdAt(sort: Desc)], map: "idx_fk_ref_links_collab")
  @@index([storeId], map: "idx_fk_ref_links_store")
  @@index([productId], map: "idx_fk_ref_links_product")
  @@index([campaignId], map: "idx_fk_ref_links_campaign")
  @@index([status, expiresAt], map: "idx_ref_links_status_expires")
  @@index([deletedAt], map: "idx_ref_links_deleted")
  @@index([customCouponCode], map: "idx_ref_links_coupon")
  @@map("referral_links")
}

model ClickTrafficLog {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referralLinkId    String       @map("referral_link_id") @db.Uuid
  ipAddress         String       @map("ip_address") @db.VarChar(45)
  userAgent         String?      @map("user_agent")
  deviceFingerprint String?      @map("device_fingerprint") @db.VarChar(255)
  deviceType        String?      @map("device_type") @db.VarChar(50)
  referrer          String?      @map("referrer") @db.VarChar(255)
  sessionId         String?      @map("session_id") @db.VarChar(100)
  accessMethod      AccessMethod @default(LINK) @map("access_method")
  isValid           Boolean      @default(true) @map("is_valid")
  rejectionReason   String?  @map("rejection_reason") @db.VarChar(150)
  utmSource         String?  @map("utm_source") @db.VarChar(100)
  utmMedium         String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign       String?  @map("utm_campaign") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([referralLinkId, createdAt(sort: Desc)], map: "idx_click_logs_link_date")
  @@map("click_traffic_logs")
}

model Campaign {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String   @map("store_id") @db.Uuid
  name                String   @db.VarChar(200)
  bonusCommissionRate Decimal  @default(5.00) @map("bonus_commission_rate") @db.Decimal(5, 2)
  startDate           DateTime @map("start_date") @db.Timestamptz(6)
  endDate             DateTime @map("end_date") @db.Timestamptz(6)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participants CampaignParticipant[]
  referralLinks ReferralLink[]
  campaignProducts CampaignProduct[]
  coupons       Coupon[]

  @@index([storeId], map: "idx_fk_campaigns_store")
  @@map("campaigns")
}

model CampaignParticipant {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId     String                    @map("campaign_id") @db.Uuid
  collaboratorId String                    @map("collaborator_id") @db.Uuid
  status         CampaignParticipantStatus @default(INVITED)
  joinedAt       DateTime?                 @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User     @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaignId, collaboratorId], map: "idx_unique_campaign_collab")
  @@index([campaignId], map: "idx_fk_campaign_part_campaign")
  @@index([collaboratorId], map: "idx_fk_campaign_part_collab")
  @@map("campaign_participants")
}

model CampaignProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaignId, productId], map: "idx_unique_campaign_product")
  @@index([campaignId], map: "idx_fk_camp_prod_campaign")
  @@index([productId], map: "idx_fk_camp_prod_product")
  @@map("campaign_products")
}

// ==========================================
// 4.5 COUPON & ATTRIBUTION SUBSYSTEM (FR-12)
// ==========================================

model Coupon {
  id                           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeNormalized               String              @unique @map("code_normalized") @db.VarChar(20)
  displayCode                  String              @map("display_code") @db.VarChar(20)
  collaboratorId               String              @map("collaborator_id") @db.Uuid
  storeId                      String              @map("store_id") @db.Uuid
  campaignId                   String?             @map("campaign_id") @db.Uuid
  status                       CouponStatus        @default(PENDING_APPROVAL)
  discountType                 DiscountType        @default(PERCENTAGE) @map("discount_type")
  discountValue                Decimal             @default(0.00) @map("discount_value") @db.Decimal(15, 2)
  minimumOrderAmount           Decimal?            @map("minimum_order_amount") @db.Decimal(15, 2)
  maximumDiscountAmount        Decimal?            @map("maximum_discount_amount") @db.Decimal(15, 2)
  usageLimitTotal              Int?                @map("usage_limit_total")
  usageLimitPerCustomer        Int                 @default(1) @map("usage_limit_per_customer")
  usageCount                   Int                 @default(0) @map("usage_count")
  budgetTotal                  Decimal?            @map("budget_total") @db.Decimal(15, 2)
  budgetUsed                   Decimal             @default(0.00) @map("budget_used") @db.Decimal(15, 2)
  startsAt                     DateTime?           @map("starts_at") @db.Timestamptz(6)
  expiresAt                    DateTime?           @map("expires_at") @db.Timestamptz(6)
  scopeType                    CouponScope         @default(STORE_WIDE) @map("scope_type")
  fundingSource                CouponFundingSource @default(SHOP_FUNDED) @map("funding_source")
  shopFundingRate              Decimal             @default(100.00) @map("shop_funding_rate") @db.Decimal(5, 2)
  platformFundingRate          Decimal             @default(0.00) @map("platform_funding_rate") @db.Decimal(5, 2)
  stackableWithProductDiscount Boolean             @default(false) @map("stackable_with_product_discount")
  stackableWithShopVoucher     Boolean             @default(false) @map("stackable_with_shop_voucher")
  stackableWithPlatformVoucher Boolean             @default(false) @map("stackable_with_platform_voucher")
  approvedBy                   String?             @map("approved_by") @db.Uuid
  approvedAt                   DateTime?           @map("approved_at") @db.Timestamptz(6)
  rejectedReason               String?             @map("rejected_reason") @db.VarChar(255)
  blockedReason                String?             @map("blocked_reason") @db.VarChar(255)
  deletedBy                    String?             @map("deleted_by") @db.Uuid
  deleteReason                 String?             @map("delete_reason") @db.VarChar(255)
  deletedAt                    DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  collaborator                 User                @relation("CollaboratorCoupons", fields: [collaboratorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  store                        Store               @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  campaign                     Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approver                     User?               @relation("CouponApprover", fields: [approvedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  couponProducts               CouponProduct[]
  couponCategories             CouponCategory[]
  redemptions                  CouponRedemption[]
  orders                       Order[]

  @@index([collaboratorId], map: "idx_fk_coupons_collaborator")
  @@index([storeId], map: "idx_fk_coupons_store")
  @@index([status, expiresAt], map: "idx_coupons_status_expires")
  @@map("coupons")
}

model CouponProduct {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([couponId, productId], map: "idx_unique_coupon_product")
  @@index([couponId], map: "idx_fk_coupon_prod_coupon")
  @@index([productId], map: "idx_fk_coupon_prod_product")
  @@map("coupon_products")
}

model CouponCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId     String   @map("coupon_id") @db.Uuid
  categoryName String   @map("category_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([couponId, categoryName], map: "idx_unique_coupon_category")
  @@index([couponId], map: "idx_fk_coupon_cat_coupon")
  @@map("coupon_categories")
}

model CouponRedemption {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId              String                 @map("coupon_id") @db.Uuid
  orderId               String                 @unique @map("order_id") @db.Uuid
  collaboratorId        String                 @map("collaborator_id") @db.Uuid
  storeId               String                 @map("store_id") @db.Uuid
  customerId            String?                @map("customer_id") @db.Uuid
  customerPhone         String?                @map("customer_phone") @db.VarChar(20)
  status                CouponRedemptionStatus @default(USED)
  discountAmount        Decimal                @map("discount_amount") @db.Decimal(15, 2)
  shopFundedAmount      Decimal                @default(0.00) @map("shop_funded_amount") @db.Decimal(15, 2)
  platformFundedAmount  Decimal                @default(0.00) @map("platform_funded_amount") @db.Decimal(15, 2)
  eligibleSubtotal      Decimal                @map("eligible_subtotal") @db.Decimal(15, 2)
  couponCodeSnapshot    String                 @map("coupon_code_snapshot") @db.VarChar(20)
  discountTypeSnapshot  DiscountType           @map("discount_type_snapshot")
  discountValueSnapshot Decimal                @map("discount_value_snapshot") @db.Decimal(15, 2)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  coupon                Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([couponId], map: "idx_fk_redemptions_coupon")
  @@index([collaboratorId], map: "idx_fk_redemptions_collab")
  @@index([storeId], map: "idx_fk_redemptions_store")
  @@index([customerPhone], map: "idx_redemptions_phone")
  @@map("coupon_redemptions")
}

// ==========================================
// 5. ORDER & COMMISSION SUBSYSTEM
// ==========================================

model Order {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                  String             @map("store_id") @db.Uuid
  externalOrderSn          String             @map("external_order_sn") @db.VarChar(100)
  idempotencyKey           String?            @unique @map("idempotency_key") @db.VarChar(100)
  cancellationToken        String?            @map("cancellation_token") @db.VarChar(100)
  attributedCollaboratorId String?            @map("attributed_collaborator_id") @db.Uuid
  attributionMethod        AttributionMethod? @map("attribution_method")
  referralLinkId           String?            @map("referral_link_id") @db.Uuid
  couponId                 String?            @map("coupon_id") @db.Uuid
  couponCodeSnapshot       String?            @map("coupon_code_snapshot") @db.VarChar(20)
  couponDiscountAmount     Decimal?           @default(0.00) @map("coupon_discount_amount") @db.Decimal(15, 2)
  overrideReason           String?            @map("override_reason") @db.VarChar(255)
  originalAttributionMethod AttributionMethod? @map("original_attribution_method")
  originalCollaboratorId   String?            @map("original_collaborator_id") @db.Uuid
  customerName             String?            @map("customer_name") @db.VarChar(150)
  customerPhone            String?            @map("customer_phone") @db.VarChar(20)
  shippingAddress          String?            @map("shipping_address")
  subtotalAmount           Decimal            @map("subtotal_amount") @db.Decimal(15, 2)
  discountAmount           Decimal            @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  shippingFee              Decimal            @default(0.00) @map("shipping_fee") @db.Decimal(12, 2)
  finalAmount              Decimal            @map("final_amount") @db.Decimal(15, 2)
  status                   OrderStatus        @default(PENDING)
  completedAt              DateTime?          @map("completed_at") @db.Timestamptz(6)
  refundedAmount           Decimal            @default(0.00) @map("refunded_amount") @db.Decimal(15, 2)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store                  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attributedCollaborator User?           @relation("AttributedCollaboratorOrders", fields: [attributedCollaboratorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referralLink           ReferralLink?   @relation(fields: [referralLinkId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coupon                 Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  couponRedemption       CouponRedemption?
  orderItems             OrderItem[]
  commissions            Commission[]
  productReviews         ProductReview[]
  refunds                OrderRefund[]

  @@unique([storeId, externalOrderSn], map: "idx_unique_store_external_order")
  @@index([storeId], map: "idx_fk_orders_store")
  @@index([attributedCollaboratorId], map: "idx_fk_orders_collab")
  @@index([referralLinkId], map: "idx_fk_orders_referral_link")
  @@index([couponId], map: "idx_fk_orders_coupon")
  @@index([status, completedAt], map: "idx_orders_status_completed")
  @@index([status, createdAt], map: "idx_orders_status_created")
  @@map("orders")
}

model OrderRefund {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  amount      Decimal           @db.Decimal(15, 2)
  reason      String?
  status      String            @default("COMPLETED") @db.VarChar(50)
  refundedAt  DateTime          @default(now()) @map("refunded_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  adjustments BonusAdjustment[]

  @@index([orderId], map: "idx_fk_order_refunds_order")
  @@map("order_refunds")
}

model BonusAdjustment {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String              @map("store_id") @db.Uuid
  collaboratorId       String              @map("collaborator_id") @db.Uuid
  originalSettlementId String?             @map("original_settlement_id") @db.Uuid
  refundId             String?             @map("refund_id") @db.Uuid
  targetYearMonth      String              @map("target_year_month") @db.VarChar(7)
  adjustmentAmount     Decimal             @map("adjustment_amount") @db.Decimal(15, 2)
  reason               String
  status               String              @default("PENDING") @db.VarChar(50)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  originalSettlement   MonthlyBonusResult? @relation(fields: [originalSettlementId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  refund               OrderRefund?        @relation(fields: [refundId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId, collaboratorId, targetYearMonth], map: "idx_bonus_adjustments_target")
  @@map("bonus_adjustments")
}

model OrderItem {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                    String        @map("order_id") @db.Uuid
  productId                  String        @map("product_id") @db.Uuid
  referralLinkId             String?       @map("referral_link_id") @db.Uuid
  quantity                   Int
  unitPrice                  Decimal       @map("unit_price") @db.Decimal(15, 2)
  appliedCommissionRate      Decimal       @map("applied_commission_rate") @db.Decimal(5, 2)
  calculatedCommissionAmount Decimal       @map("calculated_commission_amount") @db.Decimal(15, 2)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referralLink ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([orderId], map: "idx_fk_order_items_order")
  @@index([productId], map: "idx_fk_order_items_product")
  @@index([referralLinkId], map: "idx_fk_order_items_referral_link")
  @@map("order_items")
}

model Commission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  collaboratorId   String           @map("collaborator_id") @db.Uuid
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(15, 2)
  status           CommissionStatus @default(PENDING)
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User  @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, collaboratorId], map: "idx_unique_commission_order_collab")
  @@index([orderId], map: "idx_fk_commissions_order")
  @@index([collaboratorId, status], map: "idx_commissions_collab_status")
  @@map("commissions")
}

// ==========================================
// 6. FINANCIAL LEDGER & PAYOUT SUBSYSTEM
// ==========================================

model Wallet {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId   String   @unique @map("collaborator_id") @db.Uuid
  availableBalance Decimal  @default(0.00) @map("available_balance") @db.Decimal(15, 2)
  pendingBalance   Decimal  @default(0.00) @map("pending_balance") @db.Decimal(15, 2)
  version          Int      @default(1)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  collaborator     User              @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  financialLedgers FinancialLedger[]

  @@map("wallets")
}

model FinancialLedger {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String          @map("wallet_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  amount          Decimal         @db.Decimal(15, 2)
  balanceBefore   Decimal         @map("balance_before") @db.Decimal(15, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(15, 2)
  referenceId     String?         @map("reference_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([walletId, createdAt(sort: Desc)], map: "idx_ledgers_wallet_date")
  @@map("financial_ledgers")
}

model PayoutRequest {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId    String       @map("collaborator_id") @db.Uuid
  storeId           String?      @map("store_id") @db.Uuid
  amount            Decimal      @db.Decimal(15, 2) // Gross Amount
  taxAmount         Decimal      @default(0.00) @map("tax_amount") @db.Decimal(15, 2) // 10% PIT Tax
  netAmount         Decimal      @default(0.00) @map("net_amount") @db.Decimal(15, 2) // Net Amount after tax
  status            PayoutStatus @default(PENDING)
  bankName          String?      @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?      @map("bank_account_number") @db.VarChar(50)
  bankAccountName   String?      @map("bank_account_name") @db.VarChar(150)
  bankRefCode       String?      @map("bank_ref_code") @db.VarChar(100)
  proofImageUrl     String?      @map("proof_image_url")
  rejectedReason    String?      @map("rejected_reason")
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  collaborator User   @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store        Store? @relation(fields: [storeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId, status], map: "idx_payouts_store_status")
  @@index([collaboratorId, createdAt], map: "idx_payouts_pending")
  @@map("payout_requests")
}

// ==========================================
// 7. REAL-TIME CHAT & AUDIT SUBSYSTEM
// ==========================================

model Conversation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  collaboratorId String   @map("collaborator_id") @db.Uuid
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User          @relation("CollaboratorConversations", fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chatMessages ChatMessage[]

  @@index([storeId], map: "idx_fk_conversations_store")
  @@index([collaboratorId], map: "idx_fk_conversations_collab")
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  messageText    String   @map("message_text")
  mediaUrl       String?  @map("media_url")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender       User         @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "idx_fk_chat_messages_conv")
  @@index([senderId], map: "idx_fk_chat_messages_sender")
  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "idx_fk_audit_logs_user")
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

