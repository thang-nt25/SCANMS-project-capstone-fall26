  refund             OrderRefund?        @relation(fields: [refundId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId, collaboratorId, targetYearMonth], map: "idx_bonus_adjustments_target")
  @@map("bonus_adjustments")
}

model AttributionAdjustment {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  adminId                String   @map("admin_id") @db.Uuid
  previousCollaboratorId String?  @map("previous_collaborator_id") @db.Uuid
  newCollaboratorId      String?  @map("new_collaborator_id") @db.Uuid
  previousCommissionId   String?  @map("previous_commission_id") @db.Uuid
  newCommissionId        String?  @map("new_commission_id") @db.Uuid
  reason                 String   @db.VarChar(255)
  evidenceUrl            String?  @map("evidence_url")
  adjustedAt             DateTime @default(now()) @map("adjusted_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  admin              User        @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previousCommission Commission? @relation("PreviousCommissionAdjustments", fields: [previousCommissionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  newCommission      Commission? @relation("NewCommissionAdjustments", fields: [newCommissionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([orderId], map: "idx_attr_adjust_order")
  @@index([adminId], map: "idx_attr_adjust_admin")
  @@index([previousCommissionId], map: "idx_attr_adjust_prev_comm")
  @@index([newCommissionId], map: "idx_attr_adjust_new_comm")
  @@map("attribution_adjustments")
}

model OrderItem {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                    String    @map("order_id") @db.Uuid
  productId                  String    @map("product_id") @db.Uuid
  variantId                  String?   @map("variant_id") @db.Uuid
  referralLinkId             String?   @map("referral_link_id") @db.Uuid
  quantity                   Int
  unitPrice                  Decimal   @map("unit_price") @db.Decimal(15, 2)
  appliedCommissionRate      Decimal   @map("applied_commission_rate") @db.Decimal(5, 2)
  calculatedCommissionAmount Decimal   @map("calculated_commission_amount") @db.Decimal(15, 2)
  regularCommissionRate      Decimal?  @map("regular_commission_rate") @db.Decimal(5, 2)
  regularCommissionAmount    Decimal?  @map("regular_commission_amount") @db.Decimal(15, 2)
  commissionSnapshotAt       DateTime? @map("commission_snapshot_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

