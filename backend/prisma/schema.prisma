datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (CODE-FIRST DOMAIN DEFINITIONS)
// ==========================================

enum UserRole {
  SYSTEM_ADMIN
  SYSTEM_MANAGER
  SHOP_MANAGER
  COLLABORATOR
  CUSTOMER
}

enum KycStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ShopOnboardingStatus {
  DRAFT
  PENDING_APPROVAL
  NEEDS_INFO
  VERIFIED
  REJECTED
}

enum ProductModerationStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum SocialPlatform {
  TIKTOK
  FACEBOOK
  YOUTUBE
  INSTAGRAM
  THREADS
  ZALO
  TELEGRAM
  SHOPEE_VIDEO
  LEMON8
  OTHER
}

enum AssetType {
  IMAGE
  VIDEO
  COPYWRITE_TEXT
}

enum MediaAssetStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum SampleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  RECEIVED
  VIDEO_SUBMITTED
  REVISION_REQUIRED
  COMPLETED
  OVERDUE
  CANCELLED
  DELIVERY_ISSUE
}

enum AttributionMethod {
  COOKIE
  COUPON
  FINGERPRINT
  ORGANIC
}

enum AccessMethod {
  LINK
  QR
}

enum OrderStatus {
  PENDING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  DISPUTED
  RETURNED
}

enum ReturnRequestStatus {
  REQUESTED
  SHOP_APPROVED
  SHOP_REJECTED
  DISPUTED
  REFUNDED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  EXPIRED
  OTHER
}

enum OrderSourcePlatform {
  INTERNAL
  SHOPEE
  TIKTOK
  SHOPIFY
  LAZADA
  TIKI
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum TransactionType {
  COMMISSION_PENDING
  COMMISSION_APPROVED
  PAYOUT_WITHDRAW
  REVERSAL
  PAYOUT_REJECT_REFUND
}

enum WalletBalanceBucket {
  AVAILABLE
  PENDING
}

enum PayoutStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

enum CampaignParticipantStatus {
  INVITED
  ACCEPTED
  REJECTED
}

enum ReferralLinkStatus {
  ACTIVE
  PAUSED
  BLOCKED
  EXPIRED
}

enum ExclusiveDealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreCollaboratorStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum CouponStatus {
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
  BLOCKED
  DELETED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  STORE_WIDE
  PRODUCTS
  CATEGORIES
  CAMPAIGN
}

enum CouponFundingSource {
  SHOP_FUNDED
  CO_FUNDED
  PLATFORM_FUNDED
}

enum CouponRedemptionStatus {
  RESERVED
  USED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum LiveSessionStatus {
  PENDING_CREATOR
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  CANCELLED
}

enum LiveSessionPlatform {
  SCANMS
  TIKTOK
  YOUTUBE
  FACEBOOK
  OTHER
}

enum LiveSessionInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ==========================================
// 2. USER & COLLABORATOR SUBSYSTEM
// ==========================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(COLLABORATOR)
  fullName     String    @map("full_name") @db.VarChar(150)
  phoneNumber  String?   @map("phone_number") @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Reverse Relations
  stores                    Store[]
  collaboratorProfile       CollaboratorProfile?
  socialChannels            CollaboratorSocialChannel[]
  sampleProductRequests     SampleProductRequest[]
  sampleRequestEvents       SampleRequestEvent[]
  referralLinks             ReferralLink[]
  attributedOrders          Order[]                     @relation("AttributedCollaboratorOrders")
  commissions               Commission[]
  wallet                    Wallet?
  payoutRequests            PayoutRequest[]
  collaboratorConversations Conversation[]              @relation("CollaboratorConversations")
  sentChatMessages          ChatMessage[]               @relation("SentChatMessages")
  campaignParticipants      CampaignParticipant[]
  exclusiveDealProposals    ExclusiveDealProposal[]     @relation("ExclusiveDealCollaborator")
  reviewedExclusiveDeals    ExclusiveDealProposal[]     @relation("ExclusiveDealReviewer")
  storeCollaborations       StoreCollaborator[]         @relation("CollaboratorStoreRelations")
  monthlyBonusResults       MonthlyBonusResult[]        @relation("CollaboratorMonthlyBonusResults")
  auditLogs                 AuditLog[]
  coupons                   Coupon[]                    @relation("CollaboratorCoupons")
  approvedCoupons           Coupon[]                    @relation("CouponApprover")
  notifications             Notification[]
  attributionSessions       AttributionSession[]
  attributionAdjustments    AttributionAdjustment[]
  approvedPayouts           PayoutRequest[]             @relation("PayoutApprover")
  createdPayoutBatches      PayoutBatch[]               @relation("PayoutBatchCreator")
  submittedMediaAssets      MediaAsset[]                @relation("CollaboratorMediaAssets")
  reviewedMediaAssets       MediaAsset[]                @relation("ReviewerMediaAssets")
  customerAddresses         CustomerAddress[]
  customerWishlists         CustomerWishlist[]
  customerOrders            Order[]                     @relation("CustomerOrders")
  customerCartItems         CustomerCartItem[]
  customerReturnRequests    ReturnRequest[]             @relation("CustomerReturnRequests")
  customerConversations     Conversation[]              @relation("CustomerConversations")
  storeFollows              StoreFollow[]
  liveSessionsCreated       LiveShoppingSession[] @relation("LiveSessionCreator")
  liveSessionsOwned         LiveShoppingSession[] @relation("LiveSessionOwner")
  liveSessionClaims         LiveSessionClaim[]
  reviewedShopOnboardings   Store[]                 @relation("ShopOnboardingReviewer")

  @@map("users")
}

model Store {
  liveRestrictionUntil DateTime? @map("live_restriction_until") @db.Timestamptz(6)
  liveCooperationBlocked Boolean @default(false) @map("live_cooperation_blocked")
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String    @map("owner_id") @db.Uuid
  name                  String    @db.VarChar(200)
  slug                  String    @unique @db.VarChar(200)
  logoUrl               String?   @map("logo_url")
  description           String?
  websiteUrl            String?   @map("website_url") @db.VarChar(255)
  defaultCommissionRate Decimal   @default(10.00) @map("default_commission_rate") @db.Decimal(5, 2)
  attributionWindowDays Int       @default(30) @map("attribution_window_days")
  minPayoutAmount       Decimal   @default(200000.00) @map("min_payout_amount") @db.Decimal(15, 2)
  isActive              Boolean   @default(true) @map("is_active")
  isVerified            Boolean   @default(false) @map("is_verified")
  onboardingStatus      ShopOnboardingStatus @default(DRAFT) @map("onboarding_status")
  onboardingData        Json?     @map("onboarding_data")
  onboardingSubmittedAt DateTime? @map("onboarding_submitted_at") @db.Timestamptz(6)
  onboardingReviewedAt  DateTime? @map("onboarding_reviewed_at") @db.Timestamptz(6)
  onboardingReviewedById String?  @map("onboarding_reviewed_by_id") @db.Uuid
  onboardingReviewNote  String?   @map("onboarding_review_note") @db.VarChar(1000)
  policyReturn          String?   @map("policy_return")
  policyWarranty        String?   @map("policy_warranty") @db.VarChar(500)
  policyShipping        String?   @map("policy_shipping") @db.VarChar(500)
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  onboardingReviewer  User?                 @relation("ShopOnboardingReviewer", fields: [onboardingReviewedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products            Product[]
  mediaAssets         MediaAsset[]
  commissionRules     CommissionRule[]
  campaigns           Campaign[]
  orders              Order[]
  conversations       Conversation[]
  follows             StoreFollow[]
  payoutRequests      PayoutRequest[]
  monthlyBonusResults MonthlyBonusResult[]
  referralLinks       ReferralLink[]
  storeCollaborators  StoreCollaborator[]
  coupons             Coupon[]
  attributionSessions AttributionSession[]

  storeWallets           StoreWallet[]
  financialLedgers       FinancialLedger[]
  payoutBatches          PayoutBatch[]
  exclusiveDealProposals ExclusiveDealProposal[]
  liveSessions          LiveShoppingSession[]

  @@index([ownerId], map: "idx_fk_stores_owner")
  @@map("stores")
}

model StoreFollow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_follows")
}

model StoreCollaborator {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String                  @map("store_id") @db.Uuid
  collaboratorId String                  @map("collaborator_id") @db.Uuid
  status         StoreCollaboratorStatus @default(PENDING)
  approvedAt     DateTime?               @map("approved_at") @db.Timestamptz(6)
  note           String?                 @db.VarChar(255)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store        Store @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator User  @relation("CollaboratorStoreRelations", fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([storeId, collaboratorId], map: "idx_unique_store_collab")
  @@index([storeId], map: "idx_fk_store_collab_store")
  @@index([collaboratorId], map: "idx_fk_store_collab_user")
  @@map("store_collaborators")
}

model CollaboratorTier {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(50)
  minRevenueThreshold  Decimal  @default(0.00) @map("min_revenue_threshold") @db.Decimal(15, 2)
  extraBonusPercentage Decimal  @default(0.00) @map("extra_bonus_percentage") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Reverse Relations
  collaboratorProfiles CollaboratorProfile[]

  @@map("collaborator_tiers")
}

model CollaboratorProfile {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @unique @map("user_id") @db.Uuid
  tierId                    String?   @map("tier_id") @db.Uuid
  avatarUrl                 String?   @map("avatar_url")
  bio                       String?
  idCardNumber              String?   @map("id_card_number") @db.VarChar(50)
  taxCode                   String?   @map("tax_code") @db.VarChar(50)
  bankName                  String    @map("bank_name") @db.VarChar(100)
  bankAccountNumber         String    @map("bank_account_number") @db.VarChar(50)
  bankAccountName           String    @map("bank_account_name") @db.VarChar(150)
  socialLinksJson           Json?     @map("social_links_json")
  totalFollowers            Int       @default(0) @map("total_followers")
  totalEarnedCommission     Decimal   @default(0.00) @map("total_earned_commission") @db.Decimal(15, 2)
  totalOrdersReferred       Int       @default(0) @map("total_orders_referred")
  kycStatus                 KycStatus @default(UNVERIFIED) @map("kyc_status")
  sampleRequestsBlockedAt   DateTime? @map("sample_requests_blocked_at") @db.Timestamptz(6)
  sampleRequestsBlockReason String?   @map("sample_requests_block_reason") @db.VarChar(500)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tier CollaboratorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tierId], map: "idx_fk_collab_profiles_tier")
  @@map("collaborator_profiles")
}

model CollaboratorSocialChannel {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId String         @map("collaborator_id") @db.Uuid
  platformName   SocialPlatform @map("platform_name")
  channelName    String?        @map("channel_name") @db.VarChar(150)
  channelUrl     String         @map("channel_url")
  followerCount  Int            @default(0) @map("follower_count")
  isPrimary      Boolean        @default(false) @map("is_primary")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  collaborator   User                   @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sampleRequests SampleProductRequest[]

  @@index([collaboratorId], map: "idx_social_channels_collab")
  @@map("collaborator_social_channels")
}

// ==========================================
// 3. CATALOG & MEDIA ASSETS SUBSYSTEM
// ==========================================

model Product {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  sku                  String    @db.VarChar(100)
  title                String    @db.VarChar(255)
  categoryName         String?   @map("category_name") @db.VarChar(100)
  description          String?
  imageUrl             String?   @map("image_url")
  originalPrice        Decimal?  @map("original_price") @db.Decimal(15, 2)
  price                Decimal   @db.Decimal(15, 2)
  customCommissionRate Decimal?  @map("custom_commission_rate") @db.Decimal(5, 2)
  stockQuantity        Int       @default(0) @map("stock_quantity")
  isActive             Boolean   @default(true) @map("is_active")
  moderationStatus     ProductModerationStatus @default(DRAFT) @map("moderation_status")
  moderationReason     String?   @map("moderation_reason") @db.VarChar(1000)
  moderatedAt          DateTime? @map("moderated_at") @db.Timestamptz(6)
  moderatedById        String?   @map("moderated_by_id") @db.Uuid
  ingredients           String?   @db.Text
  origin                String?   @db.VarChar(255)
  labelInfo             String?   @map("label_info") @db.Text
  isAffiliateEnabled   Boolean   @default(true) @map("is_affiliate_enabled")
  sampleEnabled        Boolean   @default(false) @map("sample_enabled")
  sampleQuota          Int       @default(0) @map("sample_quota")
  sampleGrantedCount   Int       @default(0) @map("sample_granted_count")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mediaAssets            MediaAsset[]
  sampleProductRequests  SampleProductRequest[]
  referralLinks          ReferralLink[]
  orderItems             OrderItem[]
  productReviews         ProductReview[]
  campaignProducts       CampaignProduct[]
  couponProducts         CouponProduct[]
  variants               ProductVariant[]
  customerWishlists      CustomerWishlist[]
  customerCartItems      CustomerCartItem[]
  exclusiveDealProposals ExclusiveDealProposal[]
  liveSessionProducts   LiveSessionProduct[]

  @@index([storeId], map: "idx_fk_products_store")
  @@index([moderationStatus, createdAt], map: "idx_products_moderation_status_created")
  @@map("products")
}

model ProductReview {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  orderId         String?      @map("order_id") @db.Uuid
  customerName    String?      @map("customer_name") @db.VarChar(150)
  rating          Int          @default(5)
  comment         String?
  reviewImageUrl  String?      @map("review_image_url")
  images          String[]     @default([])
  video           String?      @map("video_url")
  status          ReviewStatus @default(PENDING)
  isApproved      Boolean      @default(false) @map("is_approved")
  reviewedBy      String?      @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?      @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([orderId, productId], map: "idx_unique_review_order_product")
  @@index([productId], map: "idx_fk_product_reviews_product")
  @@index([orderId], map: "idx_fk_product_reviews_order")
  @@index([status], map: "idx_fk_product_reviews_status")
  @@map("product_reviews")
}

model ProductVariant {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  sku                String   @unique @db.VarChar(100)
  name               String   @db.VarChar(150)
  attributes         Json     @default("{}")
  imageUrl           String?  @map("image_url") @db.Text
  price              Decimal? @db.Decimal(15, 2)
  stockQuantity      Int      @default(0) @map("stock_quantity")
  isActive           Boolean  @default(true) @map("is_active")
  sampleEnabled      Boolean? @map("sample_enabled")
  sampleQuota        Int?     @map("sample_quota")
  sampleGrantedCount Int      @default(0) @map("sample_granted_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderItems        OrderItem[]
  customerCartItems CustomerCartItem[]
  sampleRequests    SampleProductRequest[]
  liveSessionProducts LiveSessionProduct[]

  @@index([productId], map: "idx_fk_product_variants_product")
  @@map("product_variants")
}

model MediaAsset {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String           @map("store_id") @db.Uuid
  productId       String?          @map("product_id") @db.Uuid
  collaboratorId  String?          @map("collaborator_id") @db.Uuid
  sampleRequestId String?          @map("sample_request_id") @db.Uuid
  title           String           @db.VarChar(255)
  assetType       AssetType        @map("asset_type")
  urlOrContent    String           @map("url_or_content")
  posterUrl       String?          @map("poster_url")
  caption         String?          @db.Text
  isFeatured      Boolean          @default(false) @map("is_featured")
  status          MediaAssetStatus @default(APPROVED) @map("status")
  reviewedBy      String?          @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  isDeleted       Boolean          @default(false) @map("is_deleted")
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  collaborator  User?                 @relation("CollaboratorMediaAssets", fields: [collaboratorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sampleRequest SampleProductRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewer      User?                 @relation("ReviewerMediaAssets", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId], map: "idx_fk_media_assets_store")
  @@index([productId], map: "idx_fk_media_assets_product")
  @@index([collaboratorId], map: "idx_fk_media_assets_collaborator")
  @@index([sampleRequestId], map: "idx_fk_media_assets_sample_request")
  @@index([status], map: "idx_media_assets_status")
  @@map("media_assets")
}

model CommissionRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  name              String    @db.VarChar(150)
  description       String?
  minMonthlyRevenue Decimal   @default(0.00) @map("min_monthly_revenue") @db.Decimal(15, 2)
  achievementBonus  Decimal   @default(0.00) @map("achievement_bonus") @db.Decimal(15, 2)
  bonusPercentage   Decimal   @default(0.00) @map("bonus_percentage") @db.Decimal(5, 2)
  isActive          Boolean   @default(true) @map("is_active")
  version           Int       @default(1)
  effectiveFrom     DateTime? @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  monthlyBonusResults MonthlyBonusResult[]

  @@index([storeId], map: "idx_fk_commission_rules_store")
  @@map("commission_rules")
}

model MonthlyBonusResult {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String           @map("store_id") @db.Uuid
  collaboratorId      String           @map("collaborator_id") @db.Uuid
  yearMonth           String           @map("year_month") @db.VarChar(7) // Định dạng YYYY-MM (VD: 2026-09)
  validRevenue        Decimal          @map("valid_revenue") @db.Decimal(15, 2)
  appliedRuleId       String?          @map("applied_rule_id") @db.Uuid
  appliedRuleName     String?          @map("applied_rule_name") @db.VarChar(150)
  bonusPercentage     Decimal?         @map("bonus_percentage") @db.Decimal(5, 2)
