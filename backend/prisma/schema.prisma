  @@index([productId], map: "idx_fk_order_items_product")
  @@index([variantId], map: "idx_fk_order_items_variant")
  @@index([referralLinkId], map: "idx_fk_order_items_referral_link")
  @@map("order_items")
}

model Commission {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String           @map("order_id") @db.Uuid
  collaboratorId     String           @map("collaborator_id") @db.Uuid
  commissionAmount   Decimal          @map("commission_amount") @db.Decimal(15, 2)
  storeWalletTracked Boolean          @default(false) @map("store_wallet_tracked")
  status             CommissionStatus @default(PENDING)
  eligibleAt         DateTime         @map("eligible_at") @db.Timestamptz(6)
  availableAt        DateTime         @map("available_at") @db.Timestamptz(6)
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz(6)
  reversedAt         DateTime?        @map("reversed_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order                    Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator             User                    @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  previousOrderAdjustments AttributionAdjustment[] @relation("PreviousCommissionAdjustments")
  newOrderAdjustments      AttributionAdjustment[] @relation("NewCommissionAdjustments")

  @@unique([orderId, collaboratorId], map: "idx_unique_commission_order_collab")
  @@index([orderId], map: "idx_fk_commissions_order")
  @@index([collaboratorId, status], map: "idx_commissions_collab_status")
  @@index([status, availableAt], map: "idx_commissions_status_available")
  @@map("commissions")
}

