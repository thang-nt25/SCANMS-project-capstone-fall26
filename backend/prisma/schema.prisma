model Wallet {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId   String   @unique @map("collaborator_id") @db.Uuid
  availableBalance Decimal  @default(0.00) @map("available_balance") @db.Decimal(15, 2)
  pendingBalance   Decimal  @default(0.00) @map("pending_balance") @db.Decimal(15, 2)
  version          Int      @default(1)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  collaborator     User              @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  financialLedgers FinancialLedger[]
  storeWallets     StoreWallet[]

  @@map("wallets")
}

model FinancialLedger {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId           String              @map("wallet_id") @db.Uuid
  transactionType    TransactionType     @map("transaction_type")
  balanceBucket      WalletBalanceBucket @default(AVAILABLE) @map("balance_bucket")
  amount             Decimal             @db.Decimal(15, 2)
  balanceBefore      Decimal             @map("balance_before") @db.Decimal(15, 2)
  balanceAfter       Decimal             @map("balance_after") @db.Decimal(15, 2)
  referenceId        String?             @map("reference_id") @db.Uuid
  referenceType      String?             @map("reference_type") @db.VarChar(30)
  storeId            String?             @map("store_id") @db.Uuid
  storeBalanceBefore Decimal?            @map("store_balance_before") @db.Decimal(15, 2)
  storeBalanceAfter  Decimal?            @map("store_balance_after") @db.Decimal(15, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  store  Store? @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([walletId, createdAt(sort: Desc)], map: "idx_ledgers_wallet_date")
  @@index([storeId, createdAt(sort: Desc)], map: "idx_ledgers_store_date")
  @@map("financial_ledgers")
}

model PayoutRequest {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaboratorId     String       @map("collaborator_id") @db.Uuid
  storeId            String?      @map("store_id") @db.Uuid
  amount             Decimal      @db.Decimal(15, 2) // Gross Amount
  taxAmount          Decimal      @default(0.00) @map("tax_amount") @db.Decimal(15, 2) // 10% PIT Tax
  netAmount          Decimal      @default(0.00) @map("net_amount") @db.Decimal(15, 2) // Net Amount after tax
  status             PayoutStatus @default(PENDING)
  bankName           String?      @map("bank_name") @db.VarChar(100)
  bankAccountNumber  String?      @map("bank_account_number") @db.VarChar(50)
  bankAccountName    String?      @map("bank_account_name") @db.VarChar(150)
  bankRefCode        String?      @map("bank_ref_code") @db.VarChar(100)
  proofImageUrl      String?      @map("proof_image_url")
  proofImagePublicId String?      @map("proof_image_public_id")
  proofImageFormat   String?      @map("proof_image_format") @db.VarChar(10)
  proofImageSha256   String?      @unique(map: "idx_payouts_unique_bill_hash") @map("proof_image_sha256") @db.VarChar(64)
  approvedById       String?      @map("approved_by_id") @db.Uuid
  batchId            String?      @map("batch_id") @db.Uuid
  rejectedReason     String?      @map("rejected_reason")
  processedAt        DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  collaborator User         @relation(fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approvedBy   User?        @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  batch        PayoutBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([storeId, bankRefCode], map: "idx_payouts_store_bank_ref")
  @@index([storeId, status], map: "idx_payouts_store_status")
  @@index([collaboratorId, createdAt], map: "idx_payouts_pending")
  @@index([approvedById], map: "idx_payouts_approver")
  @@index([batchId], map: "idx_payouts_batch")
  @@map("payout_requests")
}

model StoreWallet {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId         String   @map("wallet_id") @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  availableBalance Decimal  @default(0.00) @map("available_balance") @db.Decimal(15, 2)
  pendingBalance   Decimal  @default(0.00) @map("pending_balance") @db.Decimal(15, 2)
  version          Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([walletId, storeId], map: "idx_store_wallets_wallet_store")
  @@index([storeId], map: "idx_store_wallets_store")
  @@map("store_wallets")
}

model PayoutBatch {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String          @map("store_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  fileData    Bytes           @map("file_data")
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy   User            @relation("PayoutBatchCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payouts     PayoutRequest[]

  @@index([storeId, createdAt], map: "idx_payout_batches_store_date")
  @@index([createdById], map: "idx_payout_batches_creator")
  @@map("payout_batches")
}

// ==========================================
// 7. REAL-TIME CHAT & AUDIT SUBSYSTEM
// ==========================================

model Conversation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  collaboratorId String?  @map("collaborator_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collaborator           User?                   @relation("CollaboratorConversations", fields: [collaboratorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer               User?                   @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chatMessages           ChatMessage[]
  exclusiveDealProposals ExclusiveDealProposal[]

  @@index([storeId], map: "idx_fk_conversations_store")
  @@index([collaboratorId], map: "idx_fk_conversations_collab")
  @@index([customerId], map: "idx_fk_conversations_customer")
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  messageText    String   @map("message_text")
  mediaUrl       String?  @map("media_url")
  mediaType      String?  @map("media_type") @db.VarChar(20)
  mediaName      String?  @map("media_name") @db.VarChar(255)
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender       User         @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "idx_fk_chat_messages_conv")
  @@index([senderId], map: "idx_fk_chat_messages_sender")
  @@map("chat_messages")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String?  @unique @map("event_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "idx_fk_audit_logs_user")
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  data      Json?    @db.JsonB
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

model PaymentTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.VarChar(100)
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("VND") @db.VarChar(10)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  paymentProof  String?  @map("payment_proof")
  status        String   @default("SUCCESS") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_fk_payment_transactions_order")
  @@map("payment_transactions")
}

model CustomerAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(150)
  phoneNumber   String   @map("phone_number") @db.VarChar(20)
  provinceCode  String?  @map("province_code") @db.VarChar(50)
  provinceName  String   @map("province_name") @db.VarChar(100)
  districtCode  String?  @map("district_code") @db.VarChar(50)
  districtName  String   @map("district_name") @db.VarChar(100)
  wardCode      String?  @map("ward_code") @db.VarChar(50)
  wardName      String   @map("ward_name") @db.VarChar(100)
  detailAddress String   @map("detail_address") @db.VarChar(255)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_fk_customer_addresses_user")
  @@map("customer_addresses")
}

model CustomerWishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId], map: "idx_unique_customer_wishlist")
  @@index([userId], map: "idx_fk_customer_wishlist_user")
  @@index([productId], map: "idx_fk_customer_wishlist_product")
  @@map("customer_wishlists")
}

model CustomerCartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  variantKey String   @default("base") @map("variant_key") @db.VarChar(36)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId, variantKey], map: "idx_unique_customer_cart_line")
  @@index([userId, updatedAt], map: "idx_customer_cart_user_updated")
  @@index([productId], map: "idx_customer_cart_product")
  @@index([variantId], map: "idx_customer_cart_variant")
  @@map("customer_cart_items")
}

model ReturnRequest {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String              @unique @map("order_id") @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  reason              ReturnReason
  details             String?             @db.VarChar(1000)
  imageUrls           String[]            @default([]) @map("image_urls")
  unboxingVideoUrl    String              @map("unboxing_video_url")
  status              ReturnRequestStatus @default(REQUESTED)
  originalOrderStatus OrderStatus         @default(DELIVERED) @map("original_order_status")
  deadlineAt          DateTime            @map("deadline_at") @db.Timestamptz(6)
  shopResponse        String?             @map("shop_response") @db.VarChar(1000)
  shopRespondedAt     DateTime?           @map("shop_responded_at") @db.Timestamptz(6)
  submittedAt         DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer User  @relation("CustomerReturnRequests", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([customerId, submittedAt], map: "idx_return_requests_customer")
  @@index([status, submittedAt], map: "idx_return_requests_status")
  @@map("return_requests")
}
