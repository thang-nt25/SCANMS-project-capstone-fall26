model Order {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                   String              @map("store_id") @db.Uuid
  sourcePlatform            OrderSourcePlatform @default(INTERNAL) @map("source_platform")
  rawPayload                Json?               @map("raw_payload")
  sourceUpdatedAt           DateTime?           @map("source_updated_at") @db.Timestamptz(6)
  externalOrderSn           String              @map("external_order_sn") @db.VarChar(100)
  idempotencyKey            String?             @unique @map("idempotency_key") @db.VarChar(100)
  cancellationToken         String?             @map("cancellation_token") @db.VarChar(100)
  attributedCollaboratorId  String?             @map("attributed_collaborator_id") @db.Uuid
  attributionMethod         AttributionMethod?  @map("attribution_method")
  referralLinkId            String?             @map("referral_link_id") @db.Uuid
  couponId                  String?             @map("coupon_id") @db.Uuid
  couponCodeSnapshot        String?             @map("coupon_code_snapshot") @db.VarChar(20)
  couponDiscountAmount      Decimal?            @default(0.00) @map("coupon_discount_amount") @db.Decimal(15, 2)
  overrideReason            String?             @map("override_reason") @db.VarChar(255)
  originalAttributionMethod AttributionMethod?  @map("original_attribution_method")
  originalCollaboratorId    String?             @map("original_collaborator_id") @db.Uuid
  attributionSessionId      String?             @map("attribution_session_id") @db.Uuid
  clickId                   String?             @map("click_id") @db.Uuid
  attributionConfidence     String?             @map("attribution_confidence") @db.VarChar(20)
  attributionSnapshot       Json?               @map("attribution_snapshot")
  attributedAt              DateTime?           @map("attributed_at") @db.Timestamptz(6)
  clickedAt                 DateTime?           @map("clicked_at") @db.Timestamptz(6)
  customerName              String?             @map("customer_name") @db.VarChar(150)
  customerPhone             String?             @map("customer_phone") @db.VarChar(20)
  customerEmail             String?             @map("customer_email") @db.VarChar(254)
  customerId                String?             @map("customer_id") @db.Uuid
  shippingAddress           String?             @map("shipping_address")
  subtotalAmount            Decimal             @map("subtotal_amount") @db.Decimal(15, 2)
  discountAmount            Decimal             @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  shippingFee               Decimal             @default(0.00) @map("shipping_fee") @db.Decimal(12, 2)
  finalAmount               Decimal             @map("final_amount") @db.Decimal(15, 2)
  status                    OrderStatus         @default(PENDING)
  deliveredAt               DateTime?           @map("delivered_at") @db.Timestamptz(6)
  completedAt               DateTime?           @map("completed_at") @db.Timestamptz(6)
  refundedAmount            Decimal             @default(0.00) @map("refunded_amount") @db.Decimal(15, 2)
  policyAcceptedAt          DateTime?           @map("policy_accepted_at") @db.Timestamptz(6)
  policySnapshot            Json?               @map("policy_snapshot") @db.JsonB
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  store                  Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer               User?                   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attributedCollaborator User?                   @relation("AttributedCollaboratorOrders", fields: [attributedCollaboratorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referralLink           ReferralLink?           @relation(fields: [referralLinkId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coupon                 Coupon?                 @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  couponRedemption       CouponRedemption?
  orderItems             OrderItem[]
  commissions            Commission[]
  productReviews         ProductReview[]
  refunds                OrderRefund[]
  attributionAdjustments AttributionAdjustment[]
  paymentTransactions    PaymentTransaction[]
  returnRequest          ReturnRequest?

  @@unique([storeId, sourcePlatform, externalOrderSn], map: "idx_unique_store_platform_external_order")
  @@index([storeId], map: "idx_fk_orders_store")
  @@index([customerId], map: "idx_fk_orders_customer")
  @@index([attributedCollaboratorId], map: "idx_fk_orders_collab")
  @@index([referralLinkId], map: "idx_fk_orders_referral_link")
  @@index([couponId], map: "idx_fk_orders_coupon")
  @@index([status, completedAt], map: "idx_orders_status_completed")
  @@index([status, createdAt], map: "idx_orders_status_created")
  @@map("orders")
}

model OrderRefund {
