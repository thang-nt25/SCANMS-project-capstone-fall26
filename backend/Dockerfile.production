FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV ONNXRUNTIME_NODE_INSTALL_CUDA=skip
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --fund=false --maxsockets=3 --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npx prisma generate
ARG USE_PREBUILT=false
RUN if [ "$USE_PREBUILT" = "true" ]; then cp -a deploy-dist dist; else NODE_OPTIONS=--max-old-space-size=1536 npm run build; fi
RUN npm prune --omit=dev --no-audit --fund=false

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
RUN mkdir -p /app/semantic-models && chown node:node /app/semantic-models
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
