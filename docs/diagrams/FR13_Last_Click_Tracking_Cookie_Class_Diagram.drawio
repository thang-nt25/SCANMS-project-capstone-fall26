<mxCell id="c137" value="Order.attributedCollaboratorId also references User (0..* orders per user). latestClickId, Order.attributionSessionId and clickId are scalar IDs, not @relation links." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="35" y="2350" width="2780" height="32" as="geometry"/></mxCell>
<mxCell id="c138" value="Client IP extraction is in client-ip.util.ts. No browser fingerprint SDK is used by this path; fingerprint is HMAC(subnet + normalized User-Agent)." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="35" y="2390" width="2780" height="32" as="geometry"/></mxCell>
<mxCell id="c139" value="30 days is the default, not a constant policy. Redirect uses Store attributionWindowDays within 1-365. A new valid click refreshes that Store session expiry." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="35" y="2430" width="2780" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>