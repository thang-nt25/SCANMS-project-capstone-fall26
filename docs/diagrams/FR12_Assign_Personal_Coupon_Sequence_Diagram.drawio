<mxCell id="note_0" value="Browser groups KolCouponsPage and ShopCouponsPage. JWT/role/DTO guards precede protected calls. KOL proposes the code; the owning SHOP_MANAGER sets the discount policy." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2595" width="3110" height="44" as="geometry"/></mxCell>
<mxCell id="note_1" value="Proposal requires an APPROVED partnership and commission policy. Coupon, proposal audit and notification are separate writes. Approval policy/scope changes use one transaction; approval audit/notification follow commit." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2645" width="3110" height="44" as="geometry"/></mxCell>
<mxCell id="note_2" value="Coupon owner determines KOL attribution when redeemed. Preview consumes no quota; checkout locks/revalidates coupon and writes usage, Order and redemption atomically. These later interactions are documented separately." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2700" width="3110" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>