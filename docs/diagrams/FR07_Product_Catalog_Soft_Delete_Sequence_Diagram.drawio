<mxCell id="c167" value="64. Product excluded from refreshed non-deleted catalog" style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="92" y="4077" width="346" height="41" as="geometry"/></mxCell>
<mxCell id="c168" value="Writes allow SHOP_MANAGER, SYSTEM_MANAGER, SYSTEM_ADMIN. Shop create/update/variant sync require a verified Store. Delete checks ownership but does not add that verification gate. Errors: 400 validation, 403 forbidden, 404 missing/deleted, 409 duplicate SKU." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="4186" width="3570" height="48" as="geometry"/></mxCell>
<mxCell id="c169" value="New products are DRAFT and inactive. Approved Shop content/price/image/evidence or variant-content changes can require review; stock-only changes alone do not. UI custom commission is always 10; bulk API also accepts only 10." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="4241" width="3570" height="48" as="geometry"/></mxCell>
<mxCell id="c170" value="Create and SKU sync each have their own transaction. Product edit/media replacement, SKU sync and sample-policy calls are separate writes; a later failure does not undo an earlier successful request. UI retains save errors and clears saving in finally." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="4296" width="3570" height="48" as="geometry"/></mxCell>
<mxCell id="c171" value="Variant sync deactivation excludes submitted existing IDs, not newly created IDs. This can deactivate new rows in that sync transaction; returned rows and stock sum may then differ from active rows. See analysis; diagrams do not silently repair code." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="4351" width="3570" height="48" as="geometry"/></mxCell>
<mxCell id="c172" value="Soft delete keeps Product/variants/media/order history. Backend list filters isDeleted=false. Client GET may use cache; writes invalidate /products client cache. Create does not explicitly invalidate landing cache; update, sync and delete do." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="4406" width="3570" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>