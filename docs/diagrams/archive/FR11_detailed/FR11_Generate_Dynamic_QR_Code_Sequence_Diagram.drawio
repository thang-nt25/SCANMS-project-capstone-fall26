<mxCell id="message_38" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="3324" as="sourcePoint"/><mxPoint x="495" y="3342" as="targetPoint"/><Array as="points"><mxPoint x="537" y="3324"/><mxPoint x="537" y="3342"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_38" value="38. Blob → object URL → anchor.click(); revoke URL after 1 second" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="549" y="3292" width="565" height="54" as="geometry"/></mxCell>
<mxCell id="message_39" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="3406" as="sourcePoint"/><mxPoint x="495" y="3424" as="targetPoint"/><Array as="points"><mxPoint x="537" y="3406"/><mxPoint x="537" y="3424"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_39" value="39. Increase displayed count; clear loading in finally" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="549" y="3374" width="565" height="54" as="geometry"/></mxCell>
<mxCell id="message_40" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="3488" as="sourcePoint"/><mxPoint x="115" y="3488" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_40" value="40. Browser starts SCANMS-QR-shortCode.png/svg download" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="122" y="3436" width="356" height="47" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = ReferralLinksPage + useQrDataUrl + referralLinksService. Existing link comes from FR-10. PrismaService performs database I/O; internal SQL round trips are omitted." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3598" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_1" value="JwtAuthGuard + RolesGuard run before the controller. Controller normalizes format, parses size (fallback 1024), and maps download=true/1 to a boolean; there is no QR DTO class." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3660" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_2" value="KOL: own link. Shop: Store.ownerId. SYSTEM_ADMIN / SYSTEM_MANAGER: support access. API QR excludes deleted links; it does not reject PAUSED/BLOCKED/expired status here." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3722" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_3" value="Only messages whose [guard] is true execute. Errors return immediately and skip all later steps. Cache hit, PNG miss and SVG miss are mutually exclusive; audit is skipped for own KOL downloads." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3784" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_4" value="Local preview failure shows retry in the modal. Backend inline preview uses download=false (60 requests/minute); the download flow shown uses 20 requests/minute." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3846" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_5" value="PNG renderer uses QRCode.create + PNG.sync.write; SVG uses QRCode.toString. Both encode the short URL with via=qr, ECC M and margin 4. Cache TTL is 86400 seconds." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3908" width="3240" height="50" as="geometry"/></mxCell>
<mxCell id="note_6" value="getPublicAppUrl: PUBLIC_APP_URL → FRONTEND_URL → http://localhost:5173. A scan later invokes redirect/tracking; generating/downloading QR creates no link and records no affiliate click." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="3970" width="3240" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>