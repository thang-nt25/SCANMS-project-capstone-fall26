<mxCell id="message_text_56" value="56. Show short URL and Copy action; keep success modal open" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="112" y="4712" width="386" height="48" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = ReferralLinksPage + referralLinksService HTTP adapter. JWT, COLLABORATOR role and DTO validation run before controller methods. KOL ID comes from JWT." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4880" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_1" value="Campaign calls labelled [campaignId] are skipped for Open Offer. The UI loads campaign invitations concurrently via /campaigns/my-invitations (separate API, omitted)." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4943" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_2" value="For campaign links: validate Store, dates, ACCEPTED participation and optional product scope; default expiry = campaign.endDate. Open Offer expiry, if supplied, must be future." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5006" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_3" value="Backend-only exclusiveDealId branch: APPROVED deal, matching KOL/Product/Store, approved rate, no existing non-deleted deal link; cannot combine with campaignId." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5069" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_4" value="Failure stops the flow: 400 invalid input, 401/403 authorization/KYC, 404 missing record, 409 expired campaign/retry exhausted, 429 quotas. Transaction failures roll back link + audit." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5132" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_5" value="On Prisma P2002: regenerate code + UUID and retry transaction; at most 5 attempts total. Other errors propagate. Quota counts are outside the transaction, without an atomic quota lock." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5195" width="3270" height="52" as="geometry"/></mxCell>
<mxCell id="note_6" value="publicAppUrl: PUBLIC_APP_URL → FRONTEND_URL → http://localhost:5173. QR endpoint is stored only; QR rendering, click tracking and checkout are separate interactions." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5258" width="3270" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>