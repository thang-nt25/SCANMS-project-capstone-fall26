<mxCell id="message_42" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="3811" as="sourcePoint"/><mxPoint x="1125" y="3811" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_42" value="42. Analytics result; 429 if limited" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1132" y="3759" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_43" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1115" y="3897" as="sourcePoint"/><mxPoint x="495" y="3897" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_43" value="43. Best-effort response; client catches error; playback continues" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="502" y="3845" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_44" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="3983" as="sourcePoint"/><mxPoint x="485" y="3983" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_44" value="44. Select in-stock variant and quantity; click Buy now" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="122" y="3931" width="356" height="47" as="geometry"/></mxCell>
<mxCell id="message_45" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="4069" as="sourcePoint"/><mxPoint x="495" y="4087" as="targetPoint"/><Array as="points"><mxPoint x="537" y="4069"/><mxPoint x="537" y="4087"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_45" value="45. handleBuyNow(source): require variant selection; open modal; set checkout=1" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="549" y="4035" width="535" height="56" as="geometry"/></mxCell>
<mxCell id="message_46" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="4155" as="sourcePoint"/><mxPoint x="4265" y="4155" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_46" value="46. Render GuestCheckoutModal(product, Shop, initialVariantId/quantity/coupon)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="502" y="4103" width="3756" height="47" as="geometry"/></mxCell>
<mxCell id="message_47" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4265" y="4241" as="sourcePoint"/><mxPoint x="115" y="4241" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_47" value="47. Show purchase form; no Order has been submitted yet" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="122" y="4189" width="4136" height="47" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = ProductDetailPage + api client. HTMLVideoElement and GuestCheckoutModal are separate browser participants, not a combined backend service. Videos are fetched from their source URL by the browser and may begin loading before Play." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4356" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_1" value="If the primary GET fails, the UI retries /api/products/:slug/landing through ProductsController.getLanding, which delegates to the same ProductsService. If both fail or payload lacks product.id, render the error state; finally clears loading." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4424" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_2" value="Product/Store checks occur BEFORE cache lookup. APPROVED + non-deleted product is required; missing/inactive/unverified Store returns 404; suspended owner returns 403. Product inactive or out of stock may still return 200 with canPurchase=false." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4492" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_3" value="Cache TTL = 30 seconds and key includes visitor hash (or anon) plus catalog-v1. Cache hit skips session/media/review/sold-count rebuild steps. Invalid/missing cookie or failed session lookup gives no referral priority and does not stop public browsing." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4560" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_4" value="Server media must be APPROVED/non-deleted and video URL must pass isSafeUrl. KYC badge uses CollaboratorProfile. Server sorts referred KOL first; browser then merges scanms_kol_video_submissions from localStorage and sorts featured first, which can change that order." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4628" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_5" value="Video reviews are MediaAsset; customer stars/comments are ProductReview. Rating counts/averages use only the latest 50 approved reviews; buyer badge requires COMPLETED Order. soldCount separately sums DELIVERED/COMPLETED OrderItem quantities." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4696" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_6" value="trackAnalytics sends only when scanms_analytics_consent=granted. video_start currently supplies videoId/kolName in metadata; productId/storeId are optional and absent in that call. page_view, video_complete and CTA events use the same helper; their repeated requests are omitted." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4764" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_7" value="Analytics rate limit is 60 events/60s/IP hash via checkRateLimit (separate from FR-14 click limiter). Success writes AuditLog; duplicate eventId/write errors are caught. 400 DTO/429/server failures are ignored by the client and do not stop playback." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4832" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_8" value="Playback uses native HTML video: play/pause, mute, speed, caption overlay, fullscreen. An allowed URL may still be a non-playable watch page; play errors clear isPlaying. No SDK player or automatic YouTube/TikTok iframe conversion is assumed." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4900" width="4880" height="56" as="geometry"/></mxCell>
<mxCell id="note_9" value="Add to cart uses useCart().addItem; Buy now from main/video/sticky CTA opens GuestCheckoutModal with selection. Full order/payment, media submission/moderation, voucher/sample/chat flows, SEO crawler requests and stock polling are outside this selected interaction." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4968" width="4880" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>