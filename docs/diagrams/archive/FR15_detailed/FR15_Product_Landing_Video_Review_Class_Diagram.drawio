<mxCell id="user_audits" value="auditLogs" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=none;endFill=0;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8379888268156425;entryX=0;entryY=0.20905923344947736;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="User" target="AuditLog"><mxGeometry relative="1" as="geometry"><mxPoint x="2900" y="290" as="sourcePoint"/><mxPoint x="2900" y="2690" as="targetPoint"/><Array as="points"><mxPoint x="2540" y="290"/><mxPoint x="2540" y="2690"/></Array><mxPoint x="0" y="810" as="offset"/></mxGeometry></mxCell>
<mxCell id="user_audits_source_mult" value="0..1" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="2805" y="300" width="70" height="28" as="geometry"/></mxCell>
<mxCell id="user_audits_target_mult" value="0..*" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="2815" y="2700" width="70" height="28" as="geometry"/></mxCell>
<mxCell id="browser" value="Browser in sequence = ProductDetailPage + api client + HTML video + GuestCheckoutModal. React functions and module-level trackAnalytics are not backend class methods." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="1840" width="1100" height="110" as="geometry"/></mxCell>
<mxCell id="dto" value="Response: ProductLandingResponseDto contains product, store, images, videos, reviews, availability, policies and optional status. Nested DTOs are omitted here; they are response structures, not Prisma tables." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2060" width="1100" height="120" as="geometry"/></mxCell>
<mxCell id="analytics_dto" value="TrackAnalyticsEventDto: eventId: string (UUID), event: LandingAnalyticsEvent, productId?/storeId?: string, metadata?: Record&lt;string, any&gt;. The valid video_start path is shown in the sequence." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2280" width="1100" height="110" as="geometry"/></mxCell>
<mxCell id="fr13" value="AttributionSession + ReferralLink (FR-13) are queried to prioritize the referring KOL video. They do not create a new click or change attribution here. Sold count uses OrderItem aggregate over DELIVERED/COMPLETED orders." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1500" y="2450" width="1000" height="135" as="geometry"/></mxCell>
<mxCell id="video" value="KOL videos are MediaAsset; customer ratings/comments are ProductReview. Media collaborator is optional; KYC badge comes from the separate CollaboratorProfile model. Sample/reviewer associations are outside the selected fields." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2800" width="2440" height="100" as="geometry"/></mxCell>
<mxCell id="runtime" value="Server: approved product + verified active Store/owner checks, then visitor-specific cache (30s). Browser also merges localStorage video submissions and sorts featured first. These local entries are not evidence of server moderation." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2990" width="5220" height="60" as="geometry"/></mxCell>
<mxCell id="scope" value="Selected FR-15 members and associations only. Store ownership, Store–Product/Media/Order, Product–Variant/Review/Media, KOL–Media/Profile, Order–Review and User–AuditLog follow the actual schema. Empty model operation compartments are intentional." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3090" width="5220" height="65" as="geometry"/></mxCell>
<mxCell id="analytics_note" value="Analytics stores product/Store/video IDs inside AuditLog.details JSON; no Product–AuditLog foreign key is invented. Playback requests the media URL directly. Buy now opens the checkout form; order submission/payment belong to another flow." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3195" width="5220" height="65" as="geometry"/></mxCell>
<mxCell id="legend" value="+ public     - private     Solid open arrow: retained reference     Dashed open arrow: dependency     Hollow triangle: inheritance     Solid line + multiplicities: model association" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3320" width="5220" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>