<mxCell id="order_redemption" value="couponRedemption" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=none;endFill=0;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7582938388625592;entryX=0.56;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Order" target="CouponRedemption"><mxGeometry relative="1" as="geometry"><mxPoint x="4200" y="1870" as="sourcePoint"/><mxPoint x="5200" y="2700" as="targetPoint"/><Array as="points"><mxPoint x="4420" y="1870"/><mxPoint x="4420" y="2470"/><mxPoint x="5200" y="2470"/></Array><mxPoint x="525" y="-28" as="offset"/></mxGeometry></mxCell>
<mxCell id="order_redemption_source_mult" value="1" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="4218" y="1880" width="70" height="28" as="geometry"/></mxCell>
<mxCell id="order_redemption_target_mult" value="0..1" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="5218" y="2662" width="70" height="28" as="geometry"/></mxCell>
<mxCell id="form" value="Browser = GuestCheckoutModal + api client + PayosOrderPayment. Form name is legacy: POST /api/orders requires JWT login; customerId is taken from JWT, not from client claims." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="1840" width="1150" height="110" as="geometry"/></mxCell>
<mxCell id="dto" value="CreateOrderDto: recipient name/phone/email?, shippingAddress, policyAccepted=true, coupon codes/maps?, paymentMethod?, idempotencyKey, items: OrderItemInputDto[]. Item: productId, variantId?, quantity, liveSessionId?. Client unitPrice is ignored." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2060" width="1150" height="140" as="geometry"/></mxCell>
<mxCell id="stock" value="Stock is decremented only on ProductVariant when a variant is selected; otherwise on Product. Conditional UPDATE requires enough stock and an active row. No separate Inventory model is used in this checkout path." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1600" y="2460" width="1150" height="125" as="geometry"/></mxCell>
<mxCell id="support" value="Selected PAYOS checkout scope. WalletsService debit runs inside the same tx for WALLET; MailService confirmation runs after commit. AttributionSession/ReferralLink, Notification, stacked vouchers and payment models are omitted from expanded classes." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2820" width="2690" height="110" as="geometry"/></mxCell>
<mxCell id="schema" value="Order paymentMethod/paymentStatus/requestHash and parcel snapshot are in rawPayload JSON. CouponRedemption store/collaborator/customer IDs are scalar fields, not Prisma foreign-key relations. OrderItems are schema 0..*, while checkout requires at least one." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3030" width="2690" height="110" as="geometry"/></mxCell>
<mxCell id="rules" value="Server prices and GHN shipping quote are authoritative. Missing GHN service blocks checkout; parcel dimensions are rechecked under product row locks inside tx. One-Store transaction: ReadCommitted, timeout 15s; multi-Store: one shared transaction, timeout 25s." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3350" width="5800" height="65" as="geometry"/></mxCell>
<mxCell id="payment" value="PAYOS order is PENDING with WAITING_PAYMENT and stock already deducted at commit. Payment link/QR and status polling occur afterwards. Creating an order or opening QR does not prove payment success." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3450" width="5800" height="60" as="geometry"/></mxCell>
<mxCell id="scope" value="Selected checkout members and relationships only. Product/variant price reads precede tx; coupon quota is rechecked under FOR UPDATE. DTO and remaining service dependencies are documented, not fabricated as database models." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3550" width="5800" height="60" as="geometry"/></mxCell>
<mxCell id="legend" value="+ public     - private     Solid open arrow: retained reference     Dashed open arrow: dependency     Hollow triangle: inheritance     Solid line + multiplicities: model association" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3660" width="5800" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>