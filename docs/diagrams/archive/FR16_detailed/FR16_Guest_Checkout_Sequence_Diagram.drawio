<mxCell id="message_text_53" value="53. Find owned Order, check status/amount; read/store PayOS details" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="4282" y="4705" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_54" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4275" y="4843" as="sourcePoint"/><mxPoint x="4895" y="4843" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_54" value="54. Owned order data and persisted payment details (grouped I/O)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="4282" y="4791" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_55" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4895" y="4929" as="sourcePoint"/><mxPoint x="1125" y="4929" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_55" value="55. Existing/recovered/new PayOS link + QR payload from provider" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1132" y="4877" width="3756" height="47" as="geometry"/></mxCell>
<mxCell id="message_56" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1115" y="5015" as="sourcePoint"/><mxPoint x="495" y="5015" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_56" value="56. Link/QR response; later status polling ~5s uses authenticated status endpoint" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="502" y="4963" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_57" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="5101" as="sourcePoint"/><mxPoint x="115" y="5101" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_57" value="57. Show payment QR/link; mark PAID only from confirmed server status" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="122" y="5049" width="356" height="47" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = GuestCheckoutModal + api client + PayosOrderPayment. Despite the component name, actual checkout requires login; JWT owns customerId. Public cart precheck does not reserve stock or authorize order creation." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5216" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_1" value="Before submit, UI loads address/policy/PayOS availability, previews shipping via ShippingController and optional coupon via CouponsController; those separate controller requests are summarized. UI choices are PAYOS or WALLET, default PAYOS; backend enum also supports COD/VIETQR." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5284" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_2" value="Idempotency key is retained for retries within one modal opening. Matching replay returns existing order without deducting stock again; changed payload returns 409. Database unique key is the final duplicate-write constraint. A new opening creates a new key." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5352" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_3" value="DB Product/variant price reads and GHN quote occur before tx. GHN uses buildShippingPackage from product dimensions/weight; missing dependency or failed quote blocks checkout. Inside tx, product package rows are locked FOR UPDATE and recalculated; changed parcel rejects the request." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5420" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_4" value="Conditional stock UPDATE affects exactly the selected variant OR the Product fallback, never both. Zero affected rows throws 400 OUT_OF_STOCK in current implementation. Any transaction failure rolls back prior stock, order, item, quota/redemption and notification writes." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5488" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_5" value="Only the ordinary one-Store PAYOS path is expanded. Wallet debit/payment write use the same tx for WALLET. Multi-Store checkout uses one shared ReadCommitted transaction (25s); an error in any Store rolls back all child orders. The one-Store timeout is 15s." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5556" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_6" value="Coupon preview is not redemption. Shop/KOL coupon is locked and fully revalidated inside tx, then usage/budget and redemption USED are written. Platform/shipping stacked vouchers, live/campaign checks and detailed FR-13 attribution are summarized, not assumed absent." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5624" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_7" value="Order.status=PENDING differs from rawPayload.paymentStatus=WAITING_PAYMENT/PAID. Stock decreases at successful order creation, before PayOS payment. Email is awaited after commit; failure returns FAILED status and does not undo the committed order." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5692" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_8" value="PayOS participant encapsulates provider calls and persistence after commit; reused link/recovery/new link branches are grouped. No stock tx remains open while waiting for a customer to pay. Polling and signed webhook reconciliation determine payment status, not a QR scan itself." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5760" width="5490" height="56" as="geometry"/></mxCell>
<mxCell id="note_9" value="Invalid form/DTO/stock can return 400, missing JWT 401, idempotency/coupon/parcel conflict 409, rate limit 429, service/config failures 5xx. UI shows errors, clears submitting, and can retry with the same key; later steps are skipped after a failure." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5828" width="5490" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>