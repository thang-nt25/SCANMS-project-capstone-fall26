<mxCell id="message_text_52" value="52. createLink(publicCode, userId)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1132" y="4619" width="3756" height="47" as="geometry"/></mxCell>
