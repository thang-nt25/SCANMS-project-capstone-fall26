<mxCell id="message_54" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3255" y="4525" as="sourcePoint"/><mxPoint x="795" y="4525" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_54" value="54. 201 Created + order confirmation" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="802" y="4473" width="2446" height="47" as="geometry"/></mxCell>
<mxCell id="message_55" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="4605" as="sourcePoint"/><mxPoint x="435" y="4605" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_55" value="55. Show order success" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="442" y="4553" width="336" height="47" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser groups KolCouponsPage, ShopCouponsPage, GuestCheckoutModal and couponService. Coupon/Order controller and service names are the actual code classes. PrismaService includes database I/O." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4720" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_1" value="Eligibility reads are grouped at business-operation level; code checks conditions between queries and stops on failure. Initial eligible-stores GET and list refresh GETs are omitted. JWT/role/DTO checks precede protected controller calls." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4782" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_2" value="Proposal: 4–20 A-Z/0-9, at least one letter, banned words rejected, global unique code including deleted records. APPROVED partnership + commission policy required; pending limits 5/Store, 20 overall; ACTIVE 10/Store, 100 overall per KOL." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4844" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_3" value="KOL proposes only the code. Approval requires the owning SHOP_MANAGER and 100% SHOP_FUNDED policy. [PRODUCTS/CATEGORIES] write scope rows; [CAMPAIGN] verify campaign. These optional details are grouped inside approval." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4906" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_4" value="Proposal coupon/audit/notification are separate writes. Approval policy/scope is transactional; approval audit and notification happen after commit. Notification failures are logged; these writes are not one atomic lifecycle transaction." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4968" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_5" value="Preview consumes no quota and public response hides KOL ID. Order revalidates and locks coupon; failed order transaction rolls back coupon usage/budget, inventory, Order and redemption. USED at order creation does not mean paid commission." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5030" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_6" value="Single-Store checkout shown; multi-Store UI sends couponsByStore. Coupon attribution takes priority over cookie/fingerprint. Order validation, shipping, payment, cancellation, refunds and other voucher slots are outside this selected interaction." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5092" width="5290" height="50" as="geometry"/></mxCell>
<mxCell id="note_7" value="Errors stop the relevant request: 400 invalid code/policy or quota, 401/403 authorization/partnership, 404 missing Store/coupon, 409 duplicate code/concurrent change, 429 rate limit. Later lifecycle stages require prior success." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5154" width="5290" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>