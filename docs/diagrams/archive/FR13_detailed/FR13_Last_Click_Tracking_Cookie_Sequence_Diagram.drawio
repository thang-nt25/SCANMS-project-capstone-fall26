<mxCell id="message_text_50" value="50. [fallback] Recent matching clicks, newest first" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4349" width="1236" height="47" as="geometry"/></mxCell>
<mxCell id="message_51" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4905" y="4485" as="sourcePoint"/><mxPoint x="4905" y="4503" as="targetPoint"/><Array as="points"><mxPoint x="4947" y="4485"/><mxPoint x="4947" y="4503"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_51" value="51. Choose COUPON &gt; COOKIE &gt; FINGERPRINT &gt; ORGANIC; multiple KOLs in fallback = AMBIGUOUS" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="4959" y="4451" width="535" height="56" as="geometry"/></mxCell>
<mxCell id="message_52" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4895" y="4569" as="sourcePoint"/><mxPoint x="3645" y="4569" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_52" value="52. tx.order.create(attributed KOL/link/method/confidence + attributionSnapshot)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4517" width="1236" height="47" as="geometry"/></mxCell>
<mxCell id="message_53" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3645" y="4653" as="sourcePoint"/><mxPoint x="4895" y="4653" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_53" value="53. Created Order (KOL B via COOKIE when no overriding coupon)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4601" width="1236" height="47" as="geometry"/></mxCell>
<mxCell id="message_54" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4895" y="4737" as="sourcePoint"/><mxPoint x="3645" y="4737" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_54" value="54. Return order from transaction callback" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4685" width="1236" height="47" as="geometry"/></mxCell>
<mxCell id="message_55" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3645" y="4821" as="sourcePoint"/><mxPoint x="4895" y="4821" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_55" value="55. COMMIT; transaction result" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4769" width="1236" height="47" as="geometry"/></mxCell>
<mxCell id="message_56" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4895" y="4905" as="sourcePoint"/><mxPoint x="4275" y="4905" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_56" value="56. Created order response" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="4282" y="4853" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_57" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4265" y="4989" as="sourcePoint"/><mxPoint x="495" y="4989" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_57" value="57. 201 Created + public confirmation" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="502" y="4937" width="3756" height="47" as="geometry"/></mxCell>
<mxCell id="message_58" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="5073" as="sourcePoint"/><mxPoint x="105" y="5073" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_58" value="58. Show order success" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="112" y="5021" width="366" height="47" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = RedirectHandlerPage + checkout UI. Native controller/service names match the class diagram. Imported IP/hash/token helpers are not invented classes. PrismaService includes internal database I/O." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5188" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_1" value="Only [eligible] clicks upsert the per-Store session and receive cookies. A second click repeats rate limit, lookup, status, bot/privacy and hash checks before upsert. Last processed valid update wins; no timestamp compare-and-swap is implemented." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5250" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_2" value="Cookie names: scanms_attr, scanms_attribution (legacy alias), scanms_vid. Opaque token contains v/vid/iat with HMAC; no KOL/PII/exp. Browser Max-Age and DB expiresAt use Store window (1–365 days, default 30); Secure in production, HttpOnly, SameSite=Lax." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5312" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_3" value="Queue enqueue is asynchronous (solid line, open arrow). Worker timing is illustrative: it may interleave with checkout and is not a prerequisite for cookie/session attribution. Each click job has eventId idempotency and 30-minute unique-click dedup." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5374" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_4" value="Worker transaction updates totalClicks/uniqueClicks and writes subnet IP, hashed IP, normalized UA, fingerprint hash, LINK/QR, validity and risk. Redis queue falls back to RAM; no Redis client uses transactional DB advisory-lock dedup." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5436" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_5" value="At checkout, an existing Store session can prevent fingerprint fallback even if expired/invalid. Fallback requires no Store cookie tracking/candidate, scans at most 20 valid clicks in 24h, and chooses only a single distinct eligible KOL." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5498" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_6" value="Coupon owner overrides cookie/fingerprint (FR-12). Without coupon, valid Store session points to B: COOKIE/HIGH. Fallback is FINGERPRINT/MEDIUM; ambiguous candidates produce ORGANIC/AMBIGUOUS. Order stores a snapshot, not a new click." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5560" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_7" value="404 missing/deleted link; 410 blocked link; invalid destination 400; social bot gets 200 Open Graph HTML. Rate-limited/bot/paused/expired/opt-out clicks can redirect without new attribution and can still be queued as invalid clicks." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5622" width="5490" height="50" as="geometry"/></mxCell>
<mxCell id="note_8" value="Initial session upsert and worker log transaction are separate. Session-upsert failure suppresses new attribution cookies. Consent API, worker recovery internals, legacy cookie branches and full order/shipping/payment processing are outside this selected interaction." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5684" width="5490" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>