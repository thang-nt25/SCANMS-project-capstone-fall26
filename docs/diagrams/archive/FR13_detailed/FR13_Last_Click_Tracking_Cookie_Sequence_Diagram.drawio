<mxCell id="message_text_49" value="49. [no Store tracking/cookie candidate] Read ≤20 valid fingerprint clicks in 24h" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4265" width="1236" height="47" as="geometry"/></mxCell>
