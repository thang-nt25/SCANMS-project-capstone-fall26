<mxCell id="ip_helpers" value="Imported functions: extractTrustedClientIp(req, trustProxy, proxies), normalizeClientIp(ip), hashIpForRateLimit(normalizedIp, secret). IPv4 uses full address; IPv6 uses /64 before HMAC." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2520" width="1100" height="120" as="geometry"/></mxCell>
<mxCell id="lua_data" value="Redis data, not class fields: rl:v1:click:sec:&lt;ipHash&gt; and rl:v1:click:min:&lt;ipHash&gt;. ZSET score = timestamp; member = timestamp + UUID. Rolling windows 1000/60000ms; key TTLs 3/70s." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1520" y="2170" width="1100" height="125" as="geometry"/></mxCell>
<mxCell id="types" value="checkClickRateLimitAtomic uses inline TypeScript options/result, not DTO classes. Options: ipHash, secLimit?, minLimit?, timeoutMs?. Result: allowed, limitedBy, current/remaining/resetTime (Sec/Min), isDegraded." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="1520" y="2370" width="1100" height="130" as="geometry"/></mxCell>
<mxCell id="schema_note" value="Selected Prisma models: each log has one ReferralLink; each session has one ReferralLink. latestClickId and the log Store/KOL IDs are scalar fields, not additional foreign-key associations." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3070" y="2370" width="1250" height="110" as="geometry"/></mxCell>
<mxCell id="monitoring" value="Monitoring context: RedirectController exposes rate-limit health; AdminReferralLinksController exposes the SYSTEM_ADMIN/SYSTEM_MANAGER dashboard. No separate visitor-facing rate-limit page is assumed." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3070" y="2560" width="1250" height="100" as="geometry"/></mxCell>
<mxCell id="rules" value="Rate-limited click: allowAttribution=false, riskReason includes CLICK_RATE_LIMITED, no session upsert or new attribution cookies. For a safe available destination, browser still receives 302." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2760" width="4420" height="55" as="geometry"/></mxCell>
<mxCell id="fallback" value="Limits default to 10/s + 60/min per IP hash across links/Stores. Redis Lua is shared across app instances. Error/timeout/unavailable Redis uses a bounded local Map (10000 entries), with degraded distributed enforcement." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2840" width="4420" height="55" as="geometry"/></mxCell>
<mxCell id="counts" value="Queue processing is asynchronous. New invalid events still increment totalClicks and create ClickTrafficLog; uniqueClicks does not increase. EventId prevents duplicate writes. Cookie/order attribution details remain in FR-13." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="2920" width="4420" height="55" as="geometry"/></mxCell>
<mxCell id="scope" value="Selected FR-14 members only. Product, Store, User, ConfigService, utility functions and anonymous data types are not expanded into extra classes. Empty model operation compartments are intentional." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3000" width="4420" height="55" as="geometry"/></mxCell>
<mxCell id="legend" value="+ public     - private     Solid open arrow: retained reference     Dashed open arrow: dependency     Hollow triangle: inheritance     Solid line + multiplicities: model association" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="3090" width="4420" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>