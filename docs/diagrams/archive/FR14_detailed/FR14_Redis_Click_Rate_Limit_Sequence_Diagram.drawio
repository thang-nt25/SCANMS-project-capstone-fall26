<mxCell id="message_text_45" value="45. clickTrafficLog.findUnique({eventId})" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4017" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_46" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4265" y="4155" as="sourcePoint"/><mxPoint x="3645" y="4155" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_46" value="46. Existing event or null; existing event is skipped" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4103" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_47" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3645" y="4241" as="sourcePoint"/><mxPoint x="3645" y="4259" as="targetPoint"/><Array as="points"><mxPoint x="3687" y="4241"/><mxPoint x="3687" y="4259"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_47" value="47. [new rate-limited event] isValid=false; isUnique=false; no unique-click dedup" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3699" y="4207" width="535" height="56" as="geometry"/></mxCell>
<mxCell id="message_48" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3645" y="4327" as="sourcePoint"/><mxPoint x="4265" y="4327" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_48" value="48. [new event] $transaction: referralLink.updateMany(totalClicks +1); clickTrafficLog.create" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4275" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_49" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4265" y="4413" as="sourcePoint"/><mxPoint x="3645" y="4413" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="message_text_49" value="49. [new rate-limited event] Commit log with CLICK_RATE_LIMITED; uniqueClicks unchanged" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3652" y="4361" width="606" height="47" as="geometry"/></mxCell>
<mxCell id="message_50" value="" style="rounded=0;html=0;strokeColor=#000000;strokeWidth=1.4;endArrow=block;endFill=1;endSize=10;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=18;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3645" y="4499" as="sourcePoint"/><mxPoint x="3645" y="4517" as="targetPoint"/><Array as="points"><mxPoint x="3687" y="4499"/><mxPoint x="3687" y="4517"/></Array></mxGeometry></mxCell>
<mxCell id="message_text_50" value="50. ACK success; worker errors follow retry/recovery handling" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3699" y="4465" width="535" height="56" as="geometry"/></mxCell>
<mxCell id="note_0" value="Browser = RedirectHandlerPage and product UI. Native class names match the class diagram. Redis is the actual ioredis client/server interaction; Lua internal operations are shown on its lifeline. PrismaService includes database I/O." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4614" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_1" value="Defaults: 10 accepted requests in rolling 1000ms AND 60 in rolling 60000ms per normalized IP hash, shared across links/Stores. The 11th request in the second is denied even if it uses a different link. Denied requests are not added to either window." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4682" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_2" value="extractTrustedClientIp uses proxy headers only when TRUST_PROXY is enabled and the socket proxy is trusted. IPv4 is kept whole; IPv6 is grouped by /64, then HMAC-SHA256. Limiter hash differs from the subnet/hash used for click logging." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4750" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_3" value="Lua EVAL atomically prunes, counts, tests SEC before MIN, then inserts an allowed UUID member. ZSET key TTLs 3s/70s are cleanup periods, not window lengths. resetTime values derive from TTL and are not an exact Retry-After guarantee." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4818" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_4" value="Redis error/timeout/unavailable selects the local RAM path (isDegraded=true). Caller timeout defaults to 50ms; method default is 20ms. Promise.race does not cancel a late Redis EVAL. RAM entries are local, not synchronized across instances or with Redis history." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4886" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_5" value="Rate-limit denial suppresses new attribution/session writes, not ordinary product navigation: a safe available link still returns 302. Existing cookies are not cleared. Other bot/status/product/privacy checks can also suppress attribution; a limiter allowance alone is insufficient." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="4954" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_6" value="404 missing/deleted link and 410 BLOCKED terminate processing; later guarded steps are skipped. Unsafe destination returns 400 after tracking preparation. Social crawlers may receive 200 Open Graph HTML. This diagram follows an available safe link for a regular browser." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5022" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_7" value="Async calls use solid open arrows; returns use dashed open arrows. Spike/blocked-IP pipelines are best effort. The optional click worker may run before or after redirect. EventId idempotency prevents duplicate writes; rejected click logs still increase totalClicks, never uniqueClicks." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5090" width="4900" height="56" as="geometry"/></mxCell>
<mxCell id="note_8" value="Health and restricted admin dashboard are shown as context in the class diagram. Metrics include local counters and asynchronously synchronized Redis aggregates. Worker queue transport/recovery, full FR-13 attribution and monitoring requests are outside this selected interaction." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="5158" width="4900" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>