<mxCell id="message_text_13" value="13. [sec below limit, min count &gt;= minLimit] Return denied MIN; no ZADD" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3069" y="1283" width="535" height="56" as="geometry"/></mxCell>
