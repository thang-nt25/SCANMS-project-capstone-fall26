<mxCell id="message_text_10" value="10. [Redis ready] eval(lua, 2, secKey, minKey, now, 1000, 60000, limits, 3, 70, UUID member)" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="2392" y="1007" width="606" height="47" as="geometry"/></mxCell>
