<mxCell id="message_text_12" value="12. [sec count &gt;= secLimit] Return denied SEC; no ZADD" style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="3069" y="1197" width="535" height="56" as="geometry"/></mxCell>
