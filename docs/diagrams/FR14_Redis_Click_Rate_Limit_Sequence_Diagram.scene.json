    {
      "type": "text",
      "value": "Lua atomically prunes, counts and inserts allowed requests; denied requests are not inserted. Rolling windows are 1s/60s; key cleanup TTLs are 3s/70s. These are different durations.",
      "x": 45,
      "y": 2595,
      "w": 4150,
      "h": 44,
      "size": 19,
      "align": "left",
      "bold": false
    },
    {
      "type": "text",
      "value": "Redis failure/timeout uses per-process RAM and sets isDegraded=true; it is not a shared multi-instance limiter. Caller timeout defaults to 50ms. Denial suppresses new attribution, not safe product navigation.",
      "x": 45,
      "y": 2645,
      "w": 4150,
      "h": 44,
      "size": 19,
      "align": "left",
      "bold": false
    },
