<mxCell id="c106" value="UI: RedirectHandlerPage, GuestCheckoutModal. Controllers: RedirectController, OrdersController. Service lifeline groups ReferralLinksService (redirect) and OrdersService (checkout)." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="25" y="2278" width="2770" height="42" as="geometry"/></mxCell>
<mxCell id="c107" value="Cookie stores a signed visitor ID; the winning link/KOL stays in an independent session per Store. Default expiry: 30 days, configurable 1-365. A new eligible click refreshes that Store session. Invalid/opt-out traffic sets no new attribution." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="25" y="2324" width="2770" height="48" as="geometry"/></mxCell>
<mxCell id="c108" value="Queue dedup is separate from Last-Click. Existing eventId is skipped; without Redis, DB advisory locks provide unique-click fallback. Fingerprint attribution requires an unambiguous KOL. The order saves the attribution snapshot." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="25" y="2376" width="2770" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>