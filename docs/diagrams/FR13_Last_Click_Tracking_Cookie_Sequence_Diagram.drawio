<mxCell id="note_0" value="Precondition: a prior valid A click created the visitor session; the diagram expands the later B click. Different Stores keep separate sessions. Window defaults to 30 days, configurable per Store from 1 to 365." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2595" width="3360" height="44" as="geometry"/></mxCell>
<mxCell id="note_1" value="Browser = RedirectHandlerPage + checkout UI. Traffic limiter, link cache, independent click worker and fingerprint fallback internals are summarized in FR13_CODE_ANALYSIS.md. Ineligible clicks do not replace the session." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2645" width="3360" height="44" as="geometry"/></mxCell>
<mxCell id="note_2" value="Checkout reads and writes occur within the same order transaction; the separate read/write arrows summarize its callback. Active, unexpired session/link/KOL checks apply. Cookie is not a trusted KOL ID supplied by the client." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2700" width="3360" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>