<mxCell id="c123" value="Support lifeline groups JwtAuthGuard, PayosPaymentService, CacheService, CouponsService, GhnService, WalletsService and MailService. Shipping/coupon previews use their own controllers; they do not enter OrdersController." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2935" width="3130" height="48" as="geometry"/></mxCell>
<mxCell id="c124" value="New single-Store order: transaction ReadCommitted, timeout 15s. Multi-Store: one suborder per Store in a shared transaction, timeout 25s. Inventory decreases during order creation, before PayOS payment; any transaction failure restores stock and prevents partial orders." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2990" width="3130" height="48" as="geometry"/></mxCell>
<mxCell id="c125" value="Rate limit: 30 create attempts/IP/minute and 5/phone/5 minutes (except test mode). Client unit prices are ignored. Out-of-stock currently throws HTTP 400; changed replay payload 409; unauthenticated POST 401. Failed submission keeps the form and displays the server error." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="3045" width="3130" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>