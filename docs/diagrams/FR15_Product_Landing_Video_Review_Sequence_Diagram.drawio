<mxCell id="c101" value="Primary API failure triggers frontend fallback GET /api/products/:slug/landing (ProductsController). Both use ProductsService. Fatal load errors show the error state; empty video/review lists render their empty states." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2286" width="2990" height="48" as="geometry"/></mxCell>
<mxCell id="c102" value="Add-to-cart uses CartProvider.addItem; Buy now only opens checkout. Order/payment processing is outside FR-15. Video complete and CTA events use the same consent-gated analytics path; playback fetches media directly, not through ProductsController." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2341" width="2990" height="48" as="geometry"/></mxCell>
<mxCell id="c103" value="Current gaps: stock polling calls /public/products/:id/stock but no matching route was found. Frontend featured sorting can override referral priority. Media allowlisting does not guarantee that a social watch-page URL can play in an HTML video element." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2396" width="2990" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>