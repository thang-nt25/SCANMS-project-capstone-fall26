<mxCell id="c65" value="UI updates local download count. Browser Blob URL is revoked after 1 second. Preview errors offer Retry; download errors keep the dialog open." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;fillColor=#FFFFFF;strokeColor=#000000;align=center;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="365" y="1014" width="1290" height="33" as="geometry"/></mxCell>
<mxCell id="c66" value="downloadQrCode() uses responseType=blob, format, size, download=true. JWT/role guards run before controller; service checks ownership before rate limiting." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1060" width="1640" height="28" as="geometry"/></mxCell>
<mxCell id="c67" value="After creation, preview is also local; its Download button always requests PNG 1024. Standard QR dialog offers PNG/SVG and sizes 512/1024/2048." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1093" width="1640" height="28" as="geometry"/></mxCell>
<mxCell id="c68" value="Shop owner / admin support: QR_VIEW_AUDIT or QR_DOWNLOAD_AUDIT before cache lookup. Backend inline preview limit is 60/min; UI preview does not call it." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1126" width="1640" height="28" as="geometry"/></mxCell>
<mxCell id="c69" value="Download count and support audit failures are logged without blocking the image. Render failure propagates an error. A later scan follows redirect/tracking with via=qr." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1159" width="1640" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>