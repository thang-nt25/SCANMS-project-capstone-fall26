<mxCell id="note_2" value="Missing profile is created by submitKyc. New/rejected submissions become UNVERIFIED; editing a VERIFIED profile keeps VERIFIED. UNVERIFIED plus submitted ID is displayed as pending, not a separate database PENDING status. Social channel synchronization is awaited after profile persistence." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2812" width="2750" height="44" as="geometry"/></mxCell>
<mxCell id="note_3" value="Legacy admin/pending and admin/:id/review allow Shop/Admin/Manager. Shared UI instead calls admin/applications and admin/kol/:id/review (Admin/Manager only): ordinary Shop receives 403. Shop approval through the legacy API is separate from that UI." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2867" width="2750" height="44" as="geometry"/></mxCell>
<mxCell id="note_4" value="Profile not found: 404. VERIFIED promotes CUSTOMER to COLLABORATOR and creates Wallet only if absent; REJECTED sends KOL_REJECTED. These branches are summarized. KOL writes are sequential, with no transaction or approval AuditLog in this method." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2922" width="2750" height="44" as="geometry"/></mxCell>
<mxCell id="note_5" value="Legacy reviewKyc delegates to reviewKolApplication but drops dto.note; non-VERIFIED maps to REJECTED. Bank fields belong to Profile, Wallet to User. Rejection does not remove role/Wallet. Shop onboarding and FR07 are separate; see FR03_CODE_ANALYSIS.md." style="text;html=0;fontFamily=Arial;fontColor=#000000;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="45" y="2977" width="2750" height="44" as="geometry"/></mxCell></root></mxGraphModel>