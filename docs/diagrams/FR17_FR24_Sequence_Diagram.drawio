<mxCell id="c85" value="This authenticated Customer flow does not use the public tracking reviewToken. createVerifiedReview uses one INSERT without an explicit transaction/row lock spanning its prechecks. No unimplemented lock is shown.&#xa;The current toast says Posted while the backend returns Pending moderation. This Customer modal supports images, not the public modal's video input." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;fontColor=#000000;strokeColor=#000000;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacing=12;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="2552" width="2180" height="76" as="geometry"/></mxCell>
