<mxCell id="c73" value="A repeated rejection waits for the payout lock, sees REJECTED and returns 409. It cannot refund twice; ledger uniqueness and the transaction add safeguards. This path must not refund an already executed bank transfer." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;fontColor=#000000;strokeColor=#000000;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacing=12;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="2136" width="2140" height="50" as="geometry"/></mxCell>
<mxCell id="c74" value="Refund gross, not only net, because request creation debited gross. Tax has not been recorded as remitted, so there is no extra refund beyond gross.&#xa;PROCESSING payouts may already be submitted to an external bank. The implementation blocks automatic refunds and requires separate reconciliation." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;fontColor=#000000;strokeColor=#000000;fontSize=15;fillColor=#FFFFFF;strokeColor=#000000;align=left;spacing=12;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="2250" width="2180" height="76" as="geometry"/></mxCell>
