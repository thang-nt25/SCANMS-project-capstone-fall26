<mxCell id="c130" value="Video reviews are approved MediaAsset records; customer ratings are ProductReview records. Store -&gt; MediaAsset and review -&gt; Order also exist; their fields are shown to avoid crossing lines." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2490" width="2930" height="52" as="geometry"/></mxCell>
<mxCell id="c131" value="Backend orders videos by referral KOL, featured, newest. Frontend additionally merges approved localStorage submissions and sorts featured first. The browser requests media URLs directly; no player SDK / embed conversion is used here." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2560" width="2930" height="60" as="geometry"/></mxCell>
<mxCell id="c132" value="Analytics is consent-gated. Cache TTL is 30s after product/Store checks. Inactive or out-of-stock products can still render with purchasing disabled. Anonymous structural frontend interfaces mirror the response DTO." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2640" width="2930" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>