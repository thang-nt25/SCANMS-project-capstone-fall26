  "messages": [
    [
      "customer",
      "browser",
      "Open /products/:slug"
    ],
    [
      "browser",
      "ctrl",
      "GET /api/public/products/:slug/landing"
    ],
    [
      "ctrl",
      "svc",
      "getLandingPageData(slug, attributionCookie)"
    ],
    [
      "svc",
      "db",
      "Find approved Product, active variants, Store and owner"
    ],
    [
      "db",
      "svc",
      "Product and Store eligibility data",
      "return"
    ],
    [
      "svc",
      "svc",
      "Validate Product and Store eligibility"
    ],
    [
      "svc",
      "cache",
      "get(landing key for product and visitor)"
    ],
    [
      "cache",
      "svc",
      "Cached payload or null",
      "return"
    ],
    [
      "svc",
      "db",
      "[miss] Read session priority, approved media/reviews and sold quantity"
    ],
    [
      "db",
      "svc",
      "[miss] Media with KOL/profile data, reviews and sold count",
      "return"
    ],
    [
      "svc",
      "svc",
      "[miss] Build public payload; order videos; compute availability"
    ],
    [
      "svc",
      "cache",
      "[miss] set(cacheKey, landing payload, 30)"
    ],
    [
      "cache",
      "svc",
      "[miss] Cache write completed",
      "return"
    ],
    [
      "svc",
      "ctrl",
      "ProductLandingResponseDto",
      "return"
    ],
    [
      "ctrl",
      "browser",
      "200: product, Shop, media, reviews and policies",
      "return"
    ],
    [
      "browser",
      "browser",
      "Merge matching local videos; deduplicate; featured first"
    ],
    [
      "browser",
      "customer",
      "Show product and KOL reviews",
      "return"
    ],
    [
      "customer",
      "browser",
      "Choose video; select Play"
    ],
    [
      "browser",
      "video",
      "play() using videoUrl and poster"
    ],
    [
      "video",
      "browser",
      "Playback starts or play() rejects",
      "return"
    ],
    [
      "browser",
      "browser",
      "[first play + consent] Send video_start analytics (best effort)"
    ],
    [
      "customer",
      "browser",
      "Choose variant/quantity; Buy now"
    ],
    [
      "browser",
      "browser",
      "handleBuyNow(): open GuestCheckoutModal; checkout=1"
    ],
    [
      "browser",
      "customer",
      "Show checkout form; no Order created yet",
      "return"
    ]
  ],
  "subtitle": "Main flow: public product landing → KOL review playback → open the checkout form.",
  "classNote": "Video review = MediaAsset; customer rating/comment = ProductReview. KOL User/profile, attribution, SEO and analytics models are described separately; checkout creation belongs to FR16.",
  "notes": [
    "Browser = ProductDetailPage + api client + checkout rendering. Product/Store checks occur BEFORE cache lookup. Primary request failure retries /api/products/:slug/landing via ProductsController (omitted).",
    "Server videos are APPROVED/non-deleted, with URL checks and KOL/profile data. Browser also merges matching locally approved submissions from localStorage, then sorts featured first; local data is not proof of server approval.",
    "Cache TTL is 30 seconds. Native HTML video plays/pause; analytics requires consent and does not block playback. Inactive/out-of-stock products may remain visible with canPurchase=false. Order/payment details: FR16."
  ],
