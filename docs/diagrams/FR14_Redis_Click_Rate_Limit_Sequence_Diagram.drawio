<mxCell id="c79" value="27. If Redis queue: ACK job after successful commit" style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="1812" y="1808" width="416" height="42" as="geometry"/></mxCell>
<mxCell id="c80" value="Defaults: 10 accepted clicks in a rolling second and 60 in a rolling minute per IP hash, shared across links and Stores. At limit: reject attribution; rejected requests are not inserted into the windows." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1918" width="2870" height="48" as="geometry"/></mxCell>
<mxCell id="c81" value="Rate-limit denial alone does not return HTTP 429 and does not clear an existing cookie. Link missing/deleted: 404; BLOCKED link: 410. Other bot/privacy/eligibility checks still apply. Frontend RedirectHandlerPage forwards the URL to the backend." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="1973" width="2870" height="48" as="geometry"/></mxCell>
<mxCell id="c82" value="Redis error/timeout falls back to a local timestamp Map (maximum 10,000 IP entries); distributed enforcement is degraded. Worker runs independently; logging invalid traffic increments totalClicks but not uniqueClicks." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="25" y="2028" width="2870" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>