<mxCell id="c137" value="Other FK links shown in fields: Store -&gt; Order; User -&gt; Order; Product -&gt; OrderItem; optional Coupon -&gt; Order. Product / variant stock is decremented conditionally, not both. No separate inventory table is used by this checkout path." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2620" width="3020" height="60" as="geometry"/></mxCell>
<mxCell id="c138" value="Stock + order/items + coupon usage/redemptions + wallet debit share one transaction. Multi-Store checkout creates one Order per Store in one transaction. Payment method/status are stored in rawPayload; PENDING order status and PAID payment status are distinct." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2700" width="3020" height="60" as="geometry"/></mxCell>
<mxCell id="c139" value="Supporting modules: CartProvider removes placed items after success; ShippingController quotes via GhnService; PublicCouponsController previews coupons; MailService sends optional confirmation after commit. Client prices and shipping totals are not authoritative." style="html=0;fontFamily=Arial;fontColor=#000000;fontSize=16;text;fillColor=none;strokeColor=none;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="2780" width="3020" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>