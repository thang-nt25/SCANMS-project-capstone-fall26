        <mxCell id="note" parent="1" style="text;align=left;verticalAlign=top;spacing=8;strokeColor=none;fillColor=none;html=0;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontSize=12;spacing=0;" value="KOL eligibility: active account, verified KYC, linked social channel, and no sample-request block. Invalid requests stop at the failing check. GHN API failure leaves the request unshipped. GHN TEST creates test records only and does not change the real sample status. Detailed validation queries and list refreshes are omitted." vertex="1">
          <mxGeometry height="60" width="1660" x="20" y="1550" as="geometry" />
        </mxCell>
      </root>
