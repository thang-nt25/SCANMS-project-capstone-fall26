}

Table return_disputes {
  id uuid [pk]
  return_request_id uuid [unique]
  reason varchar(100)
  details varchar(2000)
  status returndisputestatus
  ruling varchar(50)
  resolution_notes varchar(3000)
  resolved_by_id uuid
  opened_at timestamptz(6)
  resolved_at timestamptz(6)
}

// --------------------------------------------------------------------
// 10. FINANCE, WALLETS & SYSTEM
// --------------------------------------------------------------------
Table commissions {
  id uuid [pk]
  order_id uuid
  collaborator_id uuid
  commission_amount decimal(15,2)
  approved_at timestamptz(6)
  created_at timestamptz(6)
  status commissionstatus
  store_wallet_tracked boolean
  eligible_at timestamptz(6)
  available_at timestamptz(6)
  reversed_at timestamptz(6)
}

Table wallets {
  id uuid [pk]
  collaborator_id uuid [unique]
  available_balance decimal(15,2)
  pending_balance decimal(15,2)
  version integer
  updated_at timestamptz(6)
}

Table wallet_top_ups {
  id uuid [pk]
  user_id uuid
  order_code bigint
  amount decimal(15,2)
  status varchar(20)
  payment_link_id text
  checkout_url text
  qr_code text
  bin text
  account_number text
  account_name text
  description text
  expires_at timestamptz(6)
  paid_at timestamptz(6)
  next_check_at timestamptz(6)
  created_at timestamptz(6)
  updated_at timestamptz(6)
}

Table financial_ledgers {
  id uuid [pk]
  wallet_id uuid
  amount decimal(15,2)
  balance_before decimal(15,2)
  balance_after decimal(15,2)
  reference_id uuid
  created_at timestamptz(6)
  transaction_type transactiontype
  balance_bucket walletbalancebucket
  reference_type varchar(30)
  store_balance_after decimal(15,2)
  store_balance_before decimal(15,2)
  store_id uuid
}

Table payout_requests {
  id uuid [pk]
  collaborator_id uuid
  amount decimal(15,2)
  bank_ref_code varchar(100)
  proof_image_url text
  rejected_reason text
  processed_at timestamptz(6)
  created_at timestamptz(6)
  status payoutstatus
  bank_account_name varchar(150)
  bank_account_number varchar(50)
  bank_name varchar(100)
  net_amount decimal(15,2)
  tax_amount decimal(15,2)
  store_id uuid
  approved_by_id uuid
  batch_id uuid
  proof_image_format varchar(10)
  proof_image_public_id text
  proof_image_sha256 varchar(64)
}

Table payout_batches {
  id uuid [pk]
  store_id uuid
  created_by_id uuid
  created_at timestamptz(6)
  file_data bytea
}

Table conversations {
  id uuid [pk]
  store_id uuid
  collaborator_id uuid
  last_message_at timestamptz(6)
  created_at timestamptz(6)
  customer_id uuid
}

Table chat_messages {
  id uuid [pk]
  conversation_id uuid
  sender_id uuid
  message_text text
  media_url text
  is_read boolean
  created_at timestamptz(6)
  media_type varchar(20)
  media_name varchar(255)
}

Table notifications {
  id uuid [pk]
  user_id uuid
  title varchar(255)
  message text
  type varchar(50)
  data jsonb
  is_read boolean
  created_at timestamptz(6)
}

Table audit_logs {
  id uuid [pk]
  user_id uuid
  action varchar(100)
  details jsonb
  ip_address varchar(45)
  created_at timestamptz(6)
  event_id uuid
}

