  client_order_code varchar(50)
  fee_amount integer
  booked_at timestamptz(6)
  picked_up_at timestamptz(6)
}

Table return_refunds {
  id uuid [pk]
  return_request_id uuid [unique]
  amount decimal(15,2)
  method varchar(50)
  provider varchar(50)
