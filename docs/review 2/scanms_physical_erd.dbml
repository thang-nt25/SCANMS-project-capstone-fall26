// --------------------------------------------------------------------
// 1. IDENTITY & PROFILES
// --------------------------------------------------------------------
Table users {
  id uuid [pk]
  email varchar(255)
  password_hash varchar(255)
  full_name varchar(150)
  phone_number varchar(20)
  is_active boolean
  is_deleted boolean
  deleted_at timestamptz(6)
  created_at timestamptz(6)
  updated_at timestamptz(6)
  role userrole
  avatar_url text
}

Table customer_identities {
  user_id uuid [pk]
  full_name varchar(150)
  id_card_number varchar(12)
  address varchar(200)
  verification_method varchar(30)
  verified_at timestamptz(6)
  created_at timestamptz(6)
  updated_at timestamptz(6)
}

Table collaborator_profiles {
  id uuid [pk]
  user_id uuid [unique]
  tier_id uuid
  avatar_url text
  bio text
  id_card_number varchar(50)
  tax_code varchar(50)
  bank_name varchar(100)
  bank_account_number varchar(50)
  bank_account_name varchar(150)
  social_links_json jsonb
  total_followers integer
  total_earned_commission decimal(15,2)
  total_orders_referred integer
  created_at timestamptz(6)
  updated_at timestamptz(6)
  kyc_status kycstatus
  sample_requests_blocked_at timestamptz(6)
  sample_requests_block_reason varchar(500)
}

Table collaborator_tiers {
  id uuid [pk]
  name varchar(50)
  min_revenue_threshold decimal(15,2)
  extra_bonus_percentage decimal(5,2)
  created_at timestamptz(6)
}

Table collaborator_social_channels {
  id uuid [pk]
  collaborator_id uuid
  channel_name varchar(150)
  channel_url text
  follower_count integer
  is_primary boolean
  created_at timestamptz(6)
  platform_name socialplatform
}

Table customer_addresses {
  id uuid [pk]
  user_id uuid
  full_name varchar(150)
  phone_number varchar(20)
  province_code varchar(50)
  province_name varchar(100)
  district_code varchar(50)
  district_name varchar(100)
  ward_code varchar(50)
  ward_name varchar(100)
  detail_address varchar(255)
  is_default boolean
  created_at timestamptz(6)
  updated_at timestamptz(6)
  latitude decimal(10,7)
  longitude decimal(10,7)
}

// --------------------------------------------------------------------
// 2. STORES & ASSETS
// --------------------------------------------------------------------
Table stores {
  id uuid [pk]
  owner_id uuid
  name varchar(200)
  slug varchar(200)
  logo_url text
  description text
  website_url varchar(255)
  default_commission_rate decimal(5,2)
  attribution_window_days integer
  min_payout_amount decimal(15,2)
  is_deleted boolean
  deleted_at timestamptz(6)
  created_at timestamptz(6)
  updated_at timestamptz(6)
  is_active boolean
  is_verified boolean
  policy_return text
  policy_warranty varchar(500)
  policy_shipping varchar(500)
  onboarding_status shoponboardingstatus
  onboarding_data jsonb
  onboarding_submitted_at timestamptz(6)
  onboarding_reviewed_at timestamptz(6)
  onboarding_review_note varchar(1000)
  onboarding_reviewed_by_id uuid
  return_warehouse jsonb
  live_restriction_until timestamptz(6)
  live_cooperation_blocked boolean
}

Table store_collaborators {
  id uuid [pk]
  store_id uuid
  collaborator_id uuid
  status storecollaboratorstatus
  approved_at timestamptz(6)
  note varchar(255)
  created_at timestamptz(6)
  updated_at timestamptz(6)
}

Table store_follows {
  id uuid [pk]
  store_id uuid
  user_id uuid
  created_at timestamptz(6)
}

Table store_wallets {
  id uuid [pk]
  wallet_id uuid
  store_id uuid
  available_balance decimal(15,2)
  pending_balance decimal(15,2)
  version integer
  updated_at timestamptz(6)
}

Table media_assets {
  id uuid [pk]
  store_id uuid
  product_id uuid
  title varchar(255)
  url_or_content text
  is_deleted boolean
  deleted_at timestamptz(6)
  created_at timestamptz(6)
  asset_type assettype
  collaborator_id uuid
  status mediaassetstatus
  reviewed_by uuid
  reviewed_at timestamptz(6)
  rejection_reason varchar(500)
  is_featured boolean
  poster_url text
  caption text
  updated_at timestamptz(6)
  sample_request_id uuid
}

// --------------------------------------------------------------------
// 3. CATALOG & PRODUCTS
// --------------------------------------------------------------------
Table products {
  id uuid [pk]
  store_id uuid
  sku varchar(100)
  title varchar(255)
  category_name varchar(100)
  description text
  image_url text
  original_price decimal(15,2)
  price decimal(15,2)
  custom_commission_rate decimal(5,2)
  stock_quantity integer
  is_active boolean
  is_deleted boolean
  deleted_at timestamptz(6)
  created_at timestamptz(6)
  updated_at timestamptz(6)
  is_affiliate_enabled boolean
  sample_enabled boolean
  sample_quota integer
  sample_granted_count integer
  moderation_status productmoderationstatus
  moderation_reason varchar(1000)
  moderated_at timestamptz(6)
  moderated_by_id uuid
  ingredients text
  origin varchar(255)
  label_info text
}

Table product_variants {
  id uuid [pk]
  product_id uuid
  sku varchar(100) [unique]
  name varchar(150)
  price decimal(15,2)
  stock_quantity integer
  is_active boolean
  created_at timestamptz(6)
  updated_at timestamptz(6)
  sample_enabled boolean
  sample_quota integer
  sample_granted_count integer
  image_url text
  attributes jsonb
}

Table product_reviews {
  id uuid [pk]
  product_id uuid
  order_id uuid
  customer_name varchar(150)
  rating integer
  comment text
  review_image_url text
  is_approved boolean
  created_at timestamptz(6)
  status reviewstatus
  reviewed_by uuid
  reviewed_at timestamptz(6)
  rejection_reason varchar(500)
  images array
  video_url text
}

Table customer_wishlists {
  id uuid [pk]
  user_id uuid
  product_id uuid
  created_at timestamptz(6)
}

