# Copy to deploy/backend.env on the server, then replace placeholders privately.
# Do not commit backend.env. Do not copy frontend secrets into VITE_* variables.
DOMAIN=scanms.io.vn
ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL
DATABASE_URL=REPLACE_WITH_DATABASE_URL
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
DB_POOL_MAX=5

# Public Google OAuth client ID only. Register the deployed web origin in Google.
VITE_GOOGLE_CLIENT_ID=

# Keep automation off until database, providers and the deployed flows are checked.
DISABLE_SCHEDULED_JOBS=true
# Add the other required integrations from backend/.env.example privately.
# Provider credentials and certificates are backend-only.
# Never point real payouts/payment callbacks at a demo without reviewing providers.
