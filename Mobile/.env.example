# Android Emulator reaches the host computer at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Emulator debug builds only. HTTPS is required for a production server.
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=true
# Optional LAN/server values belong in your ignored .env, never credentials.
# EXPO_PUBLIC_API_URL=https://your-test-server.example/api
