FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --fund=false --maxsockets=3 --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY . .
ARG VITE_API_URL=/api
ARG VITE_SOCKET_URL=
ARG VITE_GOOGLE_CLIENT_ID=
ARG VITE_SHOW_LOGIN_ROLE_SELECTOR=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_SHOW_LOGIN_ROLE_SELECTOR=$VITE_SHOW_LOGIN_ROLE_SELECTOR
RUN NODE_OPTIONS=--max-old-space-size=1536 npm run build

FROM nginx:stable-alpine AS runtime
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
